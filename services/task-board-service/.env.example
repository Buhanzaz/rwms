# Driver Up daily-shift feature and warehouse-local workday boundary.
DRIVER_DAILY_SHIFT_ENABLED=false
DRIVER_SHIFT_DAY_START=06:00
DRIVER_SHIFT_SUSPICIOUS_ODOMETER_JUMP_KM=1500

# MET Norway Locationforecast 2.0 is free and requires an identifying, nonsecret User-Agent.
MET_NO_BASE_URL=https://api.met.no/weatherapi/locationforecast/2.0/complete
MET_NO_USER_AGENT=driver-up/replace-with-operator-contact
MET_NO_CONNECT_TIMEOUT=2s
MET_NO_READ_TIMEOUT=5s
MET_NO_CACHE_TTL=15m
MET_NO_MAX_ATTEMPTS=2

# Configurable advisory thresholds; these are Driver Up derived warnings, not official alerts.
WEATHER_HAZARD_WIND_GUST_WARNING=13.0
WEATHER_HAZARD_HEAVY_RAIN_MM_PER_HOUR=10.0
WEATHER_HAZARD_FOG_AREA_FRACTION_WARNING_PERCENT=30.0
