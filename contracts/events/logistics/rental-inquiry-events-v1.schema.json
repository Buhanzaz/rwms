{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwms.local/contracts/events/logistics/rental-inquiry-events-v1.schema.json",
  "title": "RWMS rental inquiry booking fact v1",
  "description": "Minimal sanitized fact emitted after a client presentation is converted into a draft rental order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "rentalInquiryId",
    "conversationId",
    "orderId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "logistics.rental-inquiry.booked.v1"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "rentalInquiryId": {
      "type": "string",
      "format": "uuid"
    },
    "conversationId": {
      "type": "string",
      "format": "uuid"
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    }
  }
}
