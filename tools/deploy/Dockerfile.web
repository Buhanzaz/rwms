FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY panel/package*.json ./
RUN npm ci
COPY panel/ ./
RUN npm run build && npm run build:admin && npm run build:manager \
    && mkdir -p /www/admin /www/manager \
    && cp -a dist/. /www/ && cp -a dist-admin/. /www/admin/ \
    && cp -a dist-manager/. /www/manager/
FROM nginx:1.27-alpine
COPY --from=build /www/ /usr/share/nginx/html/
COPY tools/deploy/web.conf /etc/nginx/conf.d/default.conf
