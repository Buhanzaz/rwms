    <changeSet id="2026-06-30-100000-backfill-worker-group-warehouse" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="WORKER_GROUP"/>
            <columnExists tableName="WORKER_GROUP" columnName="WAREHOUSE_ID"/>
            <tableExists tableName="WAREHOUSE"/>
        </preConditions>
        <sql>
            UPDATE WORKER_GROUP wg
               SET WAREHOUSE_ID = COALESCE(
                   (SELECT MIN(w.WAREHOUSE_ID)
                      FROM WORKER_GROUP_MEMBER wgm
                      JOIN WORKER w ON w.ID = wgm.WORKER_ID
                     WHERE wgm.WORKER_GROUP_ID = wg.ID
                       AND w.WAREHOUSE_ID IS NOT NULL),
                   (SELECT MIN(q.WAREHOUSE_ID)
                      FROM TASK_ASSIGNMENT ta
                      JOIN QUEUE_ENTRY qe ON qe.ID = ta.QUEUE_ENTRY_ID
                      JOIN WORK_QUEUE q ON q.ID = qe.QUEUE_ID
                     WHERE ta.WORKER_GROUP_ID = wg.ID
                       AND q.WAREHOUSE_ID IS NOT NULL),
                   (SELECT MIN(q.WAREHOUSE_ID)
                      FROM RENTAL_ITEM_EVENT rie
                      JOIN QUEUE_ENTRY qe ON qe.ID = rie.QUEUE_ENTRY_ID
                      JOIN WORK_QUEUE q ON q.ID = qe.QUEUE_ID
                     WHERE rie.WORKER_GROUP_ID = wg.ID
                       AND q.WAREHOUSE_ID IS NOT NULL),
                   (SELECT MIN(WAREHOUSE_ID) FROM WORK_QUEUE WHERE WAREHOUSE_ID IS NOT NULL),
                   (SELECT MIN(ID) FROM WAREHOUSE WHERE ACTIVE = TRUE),
                   (SELECT MIN(ID) FROM WAREHOUSE)
               )
             WHERE wg.WAREHOUSE_ID IS NULL;
        </sql>
    </changeSet>

    <changeSet id="2026-06-30-100010-worker-group-warehouse-not-null" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="WORKER_GROUP"/>
            <columnExists tableName="WORKER_GROUP" columnName="WAREHOUSE_ID"/>
            <sqlCheck expectedResult="0">
                select count(*) from WORKER_GROUP where WAREHOUSE_ID is null
            </sqlCheck>
        </preConditions>
        <addNotNullConstraint tableName="WORKER_GROUP"
                              columnName="WAREHOUSE_ID"
                              columnDataType="UUID"/>
    </changeSet>

