<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="27-130000-object-taxonomy-hardening-1" author="codex">
        <createTable tableName="RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="timestamp with time zone"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp with time zone"/>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="timestamp with time zone"/>
            <column name="RENTAL_CLASSIFIER_ATTRIBUTE_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="CATEGORY_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK"
                             columnNames="RENTAL_CLASSIFIER_ATTRIBUTE_ID, CATEGORY_ID"
                             constraintName="IDX_RENTAL_CLASSIFIER_ATTR_CATEGORY_UNQ"/>

        <addForeignKeyConstraint baseTableName="RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK"
                                 baseColumnNames="RENTAL_CLASSIFIER_ATTRIBUTE_ID"
                                 referencedTableName="RENTAL_CLASSIFIER_ATTRIBUTE"
                                 referencedColumnNames="ID"
                                 constraintName="FK_RENTAL_CLASSIFIER_ATTR_CATEGORY_ON_BINDING"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK"
                                 baseColumnNames="CATEGORY_ID"
                                 referencedTableName="RENTAL_CATEGORY"
                                 referencedColumnNames="ID"
                                 constraintName="FK_RENTAL_CLASSIFIER_ATTR_CATEGORY_ON_CATEGORY"/>

        <createIndex tableName="RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK"
                     indexName="IDX_RENTAL_CLASSIFIER_ATTR_CATEGORY_ON_BINDING">
            <column name="RENTAL_CLASSIFIER_ATTRIBUTE_ID"/>
        </createIndex>

        <createIndex tableName="RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK"
                     indexName="IDX_RENTAL_CLASSIFIER_ATTR_CATEGORY_ON_CATEGORY">
            <column name="CATEGORY_ID"/>
        </createIndex>
    </changeSet>

    <changeSet id="27-130000-object-taxonomy-hardening-2" author="codex">
        <sql>
            UPDATE RENTAL_CLASSIFIER_ATTRIBUTE
            SET CATEGORY_ID = (
                SELECT rs.CATEGORY_ID
                FROM RENTAL_SUBCATEGORY rs
                WHERE rs.ID = RENTAL_CLASSIFIER_ATTRIBUTE.SUBCATEGORY_ID
            )
            WHERE CATEGORY_ID IS NULL
              AND SUBCATEGORY_ID IS NOT NULL;
        </sql>

        <sql>
            UPDATE RENTAL_CLASSIFIER_ATTRIBUTE
            SET CATEGORY_ID = (
                SELECT rs.CATEGORY_ID
                FROM RENTAL_TYPE rt
                JOIN RENTAL_SUBCATEGORY rs ON rs.ID = rt.SUBCATEGORY_ID
                WHERE rt.ID = RENTAL_CLASSIFIER_ATTRIBUTE.TYPE_ID
            )
            WHERE CATEGORY_ID IS NULL
              AND TYPE_ID IS NOT NULL;
        </sql>

        <sql>
            INSERT INTO RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK (
                ID, VERSION, CREATED_DATE, RENTAL_CLASSIFIER_ATTRIBUTE_ID, CATEGORY_ID
            )
            SELECT UUID(), 0, CURRENT_TIMESTAMP, rca.ID, rca.CATEGORY_ID
            FROM RENTAL_CLASSIFIER_ATTRIBUTE rca
            WHERE rca.CATEGORY_ID IS NOT NULL
              AND NOT EXISTS (
                SELECT 1
                FROM RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK link
                WHERE link.RENTAL_CLASSIFIER_ATTRIBUTE_ID = rca.ID
                  AND link.CATEGORY_ID = rca.CATEGORY_ID
            );
        </sql>
    </changeSet>
</databaseChangeLog>
