<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-06-28-180000-repair-estimate-catalog-include-in-estimate" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="REPAIR_ESTIMATE_CATALOG_NODE" columnName="INCLUDE_IN_ESTIMATE"/>
            </not>
        </preConditions>
        <addColumn tableName="REPAIR_ESTIMATE_CATALOG_NODE">
            <column name="INCLUDE_IN_ESTIMATE" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <update tableName="REPAIR_ESTIMATE_CATALOG_NODE">
            <column name="INCLUDE_IN_ESTIMATE" valueBoolean="true"/>
            <where>NODE_TYPE in ('WORK', 'MATERIAL')</where>
        </update>
    </changeSet>

    <changeSet id="2026-06-28-180001-repair-estimate-catalog-canvas-x" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="REPAIR_ESTIMATE_CATALOG_NODE" columnName="CANVAS_X"/>
            </not>
        </preConditions>
        <addColumn tableName="REPAIR_ESTIMATE_CATALOG_NODE">
            <column name="CANVAS_X" type="int"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-06-28-180002-repair-estimate-catalog-canvas-y" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="REPAIR_ESTIMATE_CATALOG_NODE" columnName="CANVAS_Y"/>
            </not>
        </preConditions>
        <addColumn tableName="REPAIR_ESTIMATE_CATALOG_NODE">
            <column name="CANVAS_Y" type="int"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-06-28-180003-reset-repair-estimate-task-plan-follow-up-node" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="REPAIR_ESTIMATE_TASK_PLAN"/>
            <columnExists tableName="REPAIR_ESTIMATE_TASK_PLAN" columnName="FOLLOW_UP_NODE_ID"/>
        </preConditions>
        <sql>
            UPDATE REPAIR_ESTIMATE_TASK_PLAN
            SET FOLLOW_UP_NODE_ID = NULL
            WHERE FOLLOW_UP_NODE_ID IS NOT NULL
        </sql>
    </changeSet>

    <changeSet id="2026-06-28-180004-reset-repair-estimate-catalog-links" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="REPAIR_ESTIMATE_CATALOG_LINK"/>
        </preConditions>
        <delete tableName="REPAIR_ESTIMATE_CATALOG_LINK"/>
    </changeSet>

    <changeSet id="2026-06-28-180005-reset-repair-estimate-catalog-nodes" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="REPAIR_ESTIMATE_CATALOG_NODE"/>
        </preConditions>
        <sql>
            UPDATE REPAIR_ESTIMATE_CATALOG_NODE
            SET PARENT_ID = NULL
            WHERE PARENT_ID IS NOT NULL
        </sql>
        <delete tableName="REPAIR_ESTIMATE_CATALOG_NODE"/>
    </changeSet>

</databaseChangeLog>
