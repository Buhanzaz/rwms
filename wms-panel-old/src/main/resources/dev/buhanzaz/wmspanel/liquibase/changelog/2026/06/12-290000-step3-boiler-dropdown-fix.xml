        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*)
                    FROM RENTAL_ATTRIBUTE_DEFINITION
                    WHERE CODE = 'BOILER'
                      AND DATA_TYPE = 'ENUM'
                </sqlCheck>
            </not>
        </preConditions>
        <update tableName="RENTAL_ATTRIBUTE_DEFINITION">
            <column name="DATA_TYPE" value="ENUM"/>
            <where>CODE = 'BOILER' AND COALESCE(DATA_TYPE, '') &lt;&gt; 'ENUM'</where>
        </update>
    </changeSet>

