<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-06-30-210000-repair-catalog-two-link-types" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="REPAIR_ESTIMATE_CATALOG_LINK"/>
            <columnExists tableName="REPAIR_ESTIMATE_CATALOG_LINK" columnName="LINK_TYPE"/>
        </preConditions>
        <update tableName="REPAIR_ESTIMATE_CATALOG_LINK">
            <column name="LINK_TYPE" value="DEPENDENCY"/>
            <where>LINK_TYPE = 'WORK_MATERIAL'</where>
        </update>
    </changeSet>

</databaseChangeLog>
