<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="2026-06-22-100000-repair-process" author="codex">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="REPAIR_PROCESS"/></not>
        </preConditions>
        <createTable tableName="REPAIR_PROCESS">
            <column name="ID" type="UUID"><constraints nullable="false" primaryKey="true" primaryKeyName="PK_REPAIR_PROCESS"/></column>
            <column name="VERSION" type="INT"><constraints nullable="false"/></column>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="timestamp with time zone"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp with time zone"/>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="timestamp with time zone"/>
            <column name="ESTIMATE_ID" type="UUID"><constraints nullable="false"/></column>
            <column name="RENTAL_ITEM_ID" type="UUID"><constraints nullable="false"/></column>
            <column name="WAREHOUSE_ID" type="UUID"><constraints nullable="false"/></column>
            <column name="STATUS" type="VARCHAR(32)" defaultValue="ACTIVE"><constraints nullable="false"/></column>
            <column name="MOVE_TO_REPAIR_REQUIRED" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="MOVE_TO_REPAIR_DONE" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="MOVE_TO_REPAIR_CANCELLED" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="MOVE_FROM_REPAIR_REQUIRED" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="MOVE_FROM_REPAIR_DONE" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="MOVE_FROM_REPAIR_CANCELLED" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="ACCEPTED_AT" type="timestamp with time zone"/>
            <column name="ACCEPTED_BY" type="VARCHAR(255)"/>
            <column name="ACCEPTANCE_COMMENT" type="VARCHAR(2000)"/>
            <column name="COMMENT_" type="VARCHAR(2000)"/>
        </createTable>
        <addUniqueConstraint tableName="REPAIR_PROCESS" columnNames="ESTIMATE_ID" constraintName="IDX_REPAIR_PROCESS_UNQ_ESTIMATE"/>
        <addForeignKeyConstraint baseTableName="REPAIR_PROCESS" baseColumnNames="ESTIMATE_ID" referencedTableName="REPAIR_ESTIMATE" referencedColumnNames="ID" constraintName="FK_REPAIR_PROCESS_ON_ESTIMATE"/>
        <addForeignKeyConstraint baseTableName="REPAIR_PROCESS" baseColumnNames="RENTAL_ITEM_ID" referencedTableName="RENTAL_ITEM" referencedColumnNames="ID" constraintName="FK_REPAIR_PROCESS_ON_RENTAL_ITEM"/>
        <addForeignKeyConstraint baseTableName="REPAIR_PROCESS" baseColumnNames="WAREHOUSE_ID" referencedTableName="WAREHOUSE" referencedColumnNames="ID" constraintName="FK_REPAIR_PROCESS_ON_WAREHOUSE"/>
    </changeSet>

    <changeSet id="2026-06-22-100001-repair-process-task-line" author="codex">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="REPAIR_PROCESS_TASK_LINE"/></not>
        </preConditions>
        <createTable tableName="REPAIR_PROCESS_TASK_LINE">
            <column name="ID" type="UUID"><constraints nullable="false" primaryKey="true" primaryKeyName="PK_REPAIR_PROCESS_TASK_LINE"/></column>
            <column name="TASK_PLAN_ID" type="UUID"><constraints nullable="false"/></column>
            <column name="ESTIMATE_LINE_ID" type="UUID"><constraints nullable="false"/></column>
            <column name="LINE_TYPE" type="VARCHAR(32)" defaultValue="WORK"><constraints nullable="false"/></column>
            <column name="SORT_ORDER" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="PRIMARY_WORK_LINE" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="REPAIR_PROCESS_TASK_LINE" baseColumnNames="TASK_PLAN_ID" referencedTableName="REPAIR_ESTIMATE_TASK_PLAN" referencedColumnNames="ID" constraintName="FK_REPAIR_PROCESS_TASK_LINE_ON_PLAN"/>
        <addForeignKeyConstraint baseTableName="REPAIR_PROCESS_TASK_LINE" baseColumnNames="ESTIMATE_LINE_ID" referencedTableName="REPAIR_ESTIMATE_LINE" referencedColumnNames="ID" constraintName="FK_REPAIR_PROCESS_TASK_LINE_ON_LINE"/>
        <createIndex tableName="REPAIR_PROCESS_TASK_LINE" indexName="IDX_REPAIR_PROCESS_TASK_LINE_ON_PLAN">
            <column name="TASK_PLAN_ID"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026-06-22-100002-board-task-photo-link" author="codex">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="BOARD_TASK_PHOTO_LINK"/></not>
        </preConditions>
        <createTable tableName="BOARD_TASK_PHOTO_LINK">
            <column name="ID" type="UUID"><constraints nullable="false" primaryKey="true" primaryKeyName="PK_BOARD_TASK_PHOTO_LINK"/></column>
            <column name="BOARD_TASK_ID" type="UUID"><constraints nullable="false"/></column>
            <column name="PHOTO_ID" type="UUID"><constraints nullable="false"/></column>
            <column name="PHOTO_TYPE" type="VARCHAR(32)" defaultValue="WORK"><constraints nullable="false"/></column>
            <column name="SORT_ORDER" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="BOARD_TASK_PHOTO_LINK" baseColumnNames="BOARD_TASK_ID" referencedTableName="BOARD_TASK" referencedColumnNames="ID" constraintName="FK_BOARD_TASK_PHOTO_LINK_ON_TASK"/>
        <addForeignKeyConstraint baseTableName="BOARD_TASK_PHOTO_LINK" baseColumnNames="PHOTO_ID" referencedTableName="RENTAL_ITEM_EVENT_PHOTO" referencedColumnNames="ID" constraintName="FK_BOARD_TASK_PHOTO_LINK_ON_PHOTO"/>
    </changeSet>

    <changeSet id="2026-06-22-100003-repair-task-plan-process-column" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="REPAIR_ESTIMATE_TASK_PLAN"/>
            <not><columnExists tableName="REPAIR_ESTIMATE_TASK_PLAN" columnName="REPAIR_PROCESS_ID"/></not>
        </preConditions>
        <addColumn tableName="REPAIR_ESTIMATE_TASK_PLAN">
            <column name="REPAIR_PROCESS_ID" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="REPAIR_ESTIMATE_TASK_PLAN" baseColumnNames="REPAIR_PROCESS_ID" referencedTableName="REPAIR_PROCESS" referencedColumnNames="ID" constraintName="FK_REPAIR_ESTIMATE_TASK_PLAN_ON_PROCESS"/>
    </changeSet>

    <changeSet id="2026-06-22-100004-board-task-process-columns" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="BOARD_TASK"/>
        </preConditions>
        <addColumn tableName="BOARD_TASK">
            <column name="REPAIR_PROCESS_ID" type="UUID"/>
            <column name="CREW_TYPE_ID" type="UUID"/>
            <column name="CREW_ID" type="UUID"/>
            <column name="TASK_KIND" type="VARCHAR(32)" defaultValue="REPAIR_WORK"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="BOARD_TASK" baseColumnNames="REPAIR_PROCESS_ID" referencedTableName="REPAIR_PROCESS" referencedColumnNames="ID" constraintName="FK_BOARD_TASK_ON_REPAIR_PROCESS"/>
        <addForeignKeyConstraint baseTableName="BOARD_TASK" baseColumnNames="CREW_TYPE_ID" referencedTableName="WORKER_CREW_TYPE" referencedColumnNames="ID" constraintName="FK_BOARD_TASK_ON_CREW_TYPE"/>
        <addForeignKeyConstraint baseTableName="BOARD_TASK" baseColumnNames="CREW_ID" referencedTableName="WORKER_CREW" referencedColumnNames="ID" constraintName="FK_BOARD_TASK_ON_CREW"/>
    </changeSet>

    <changeSet id="2026-06-22-100005-task-assignment-worker-columns" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="TASK_ASSIGNMENT"/>
        </preConditions>
        <addColumn tableName="TASK_ASSIGNMENT">
            <column name="CREW_ID" type="UUID"/>
            <column name="WORKER_ID" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="TASK_ASSIGNMENT" baseColumnNames="CREW_ID" referencedTableName="WORKER_CREW" referencedColumnNames="ID" constraintName="FK_TASK_ASSIGNMENT_ON_CREW"/>
        <addForeignKeyConstraint baseTableName="TASK_ASSIGNMENT" baseColumnNames="WORKER_ID" referencedTableName="WORKER" referencedColumnNames="ID" constraintName="FK_TASK_ASSIGNMENT_ON_WORKER"/>
    </changeSet>

    <changeSet id="2026-06-22-100006-task-time-event-worker-column" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="TASK_TIME_EVENT"/>
            <not><columnExists tableName="TASK_TIME_EVENT" columnName="WORKER_ID"/></not>
        </preConditions>
        <addColumn tableName="TASK_TIME_EVENT">
            <column name="WORKER_ID" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="TASK_TIME_EVENT" baseColumnNames="WORKER_ID" referencedTableName="WORKER" referencedColumnNames="ID" constraintName="FK_TASK_TIME_EVENT_ON_WORKER"/>
    </changeSet>

    <changeSet id="2026-06-22-100007-repair-catalog-photo-required" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="REPAIR_ESTIMATE_CATALOG_NODE"/>
            <not><columnExists tableName="REPAIR_ESTIMATE_CATALOG_NODE" columnName="PHOTO_REQUIRED"/></not>
        </preConditions>
        <addColumn tableName="REPAIR_ESTIMATE_CATALOG_NODE">
            <column name="PHOTO_REQUIRED" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
