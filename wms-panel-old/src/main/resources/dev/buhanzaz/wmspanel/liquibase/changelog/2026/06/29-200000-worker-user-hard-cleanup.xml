    <changeSet id="2026-06-29-200000-backfill-worker-user-into-worker" author="codex">
        <validCheckSum>9:29bc698bde85635338155be1e62063f5</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="WORKER_USER"/>
            <tableExists tableName="WORKER"/>
            <tableExists tableName="WAREHOUSE"/>
        </preConditions>
        <sql>
            INSERT INTO WORKER (
                ID,
                VERSION,
                DELETED_BY,
                DELETED_DATE,
                LAST_MODIFIED_BY,
                LAST_MODIFIED_DATE,
                CREATED_BY,
                CREATED_DATE,
                WAREHOUSE_ID,
                FIRST_NAME,
                LAST_NAME,
                MIDDLE_NAME,
                DISPLAY_NAME,
                ACTIVE,
                COMMENT_,
                APP_LOGIN,
                APP_PASSWORD
            )
            SELECT
                wu.ID,
                COALESCE(wu.VERSION, 0),
                wu.DELETED_BY,
                wu.DELETED_DATE,
                wu.LAST_MODIFIED_BY,
                wu.LAST_MODIFIED_DATE,
                wu.CREATED_BY,
                wu.CREATED_DATE,
                COALESCE(
                    (SELECT rie.WAREHOUSE_ID
                     FROM RENTAL_ITEM_EVENT rie
                     WHERE rie.WORKER_USER_ID = wu.ID
                     FETCH FIRST 1 ROWS ONLY),
                    (SELECT q.WAREHOUSE_ID
                     FROM TASK_ASSIGNMENT ta
                     JOIN QUEUE_ENTRY qe ON qe.ID = ta.QUEUE_ENTRY_ID
                     JOIN WORK_QUEUE q ON q.ID = qe.QUEUE_ID
                     WHERE ta.WORKER_USER_ID = wu.ID
                     FETCH FIRST 1 ROWS ONLY),
                    (SELECT q.WAREHOUSE_ID
                     FROM TASK_TIME_EVENT tte
                     JOIN QUEUE_ENTRY qe ON qe.ID = tte.QUEUE_ENTRY_ID
                     JOIN WORK_QUEUE q ON q.ID = qe.QUEUE_ID
                     WHERE tte.WORKER_USER_ID = wu.ID
                     FETCH FIRST 1 ROWS ONLY),
                    (SELECT wg.WAREHOUSE_ID
                     FROM WORKER_GROUP_MEMBER wgm
                     JOIN WORKER_GROUP wg ON wg.ID = wgm.WORKER_GROUP_ID
                     WHERE wgm.WORKER_USER_ID = wu.ID
                       AND wg.WAREHOUSE_ID IS NOT NULL
                     FETCH FIRST 1 ROWS ONLY),
                    (SELECT MIN(ID) FROM WAREHOUSE WHERE ACTIVE = TRUE),
                    (SELECT MIN(ID) FROM WAREHOUSE)
                ),
                NULL,
                NULL,
                NULL,
                wu.DISPLAY_NAME,
                COALESCE(wu.ACTIVE, TRUE),
                'Migrated from legacy WORKER_USER',
                NULL,
                NULL
            FROM WORKER_USER wu
            WHERE NOT EXISTS (
                SELECT 1
                FROM WORKER w
                WHERE w.ID = wu.ID
            );
        </sql>
    </changeSet>

    <changeSet id="2026-06-29-200100-backfill-worker-foreign-keys" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="WORKER_USER"/>
        </preConditions>
        <sql>
            UPDATE WORKER_GROUP_MEMBER
               SET WORKER_ID = WORKER_USER_ID
             WHERE WORKER_ID IS NULL
               AND WORKER_USER_ID IS NOT NULL
               AND EXISTS (SELECT 1 FROM WORKER w WHERE w.ID = WORKER_GROUP_MEMBER.WORKER_USER_ID);

            UPDATE TASK_ASSIGNMENT
               SET WORKER_ID = WORKER_USER_ID
             WHERE WORKER_ID IS NULL
               AND WORKER_USER_ID IS NOT NULL
               AND EXISTS (SELECT 1 FROM WORKER w WHERE w.ID = TASK_ASSIGNMENT.WORKER_USER_ID);

            UPDATE TASK_TIME_EVENT
               SET WORKER_ID = WORKER_USER_ID
             WHERE WORKER_ID IS NULL
               AND WORKER_USER_ID IS NOT NULL
               AND EXISTS (SELECT 1 FROM WORKER w WHERE w.ID = TASK_TIME_EVENT.WORKER_USER_ID);

            UPDATE RENTAL_ITEM_EVENT
               SET WORKER_ID = WORKER_USER_ID
             WHERE WORKER_ID IS NULL
               AND WORKER_USER_ID IS NOT NULL
               AND EXISTS (SELECT 1 FROM WORKER w WHERE w.ID = RENTAL_ITEM_EVENT.WORKER_USER_ID);
        </sql>
    </changeSet>

    <changeSet id="2026-06-29-200200-worker-group-member-worker-not-null" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="WORKER_GROUP_MEMBER"/>
            <columnExists tableName="WORKER_GROUP_MEMBER" columnName="WORKER_ID"/>
            <sqlCheck expectedResult="0">
                select count(*) from WORKER_GROUP_MEMBER where WORKER_ID is null
            </sqlCheck>
        </preConditions>
        <addNotNullConstraint tableName="WORKER_GROUP_MEMBER"
                              columnName="WORKER_ID"
