<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="2026-06-28-140000-rental-item-accessory" author="codex">
        <createTable tableName="RENTAL_ITEM_ACCESSORY">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_RENTAL_ITEM_ACCESSORY"/>
            </column>
            <column name="VERSION" type="INT"/>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="TIMESTAMP"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="TIMESTAMP"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="TIMESTAMP"/>
            <column name="RENTAL_ITEM_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="ACCESSORY_ITEM_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="QUANTITY" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="RENTAL_ITEM_ACCESSORY" baseColumnNames="RENTAL_ITEM_ID"
                                 referencedTableName="RENTAL_ITEM" referencedColumnNames="ID"
                                 constraintName="FK_RENTAL_ITEM_ACCESSORY_ON_RENTAL_ITEM"/>
        <addForeignKeyConstraint baseTableName="RENTAL_ITEM_ACCESSORY" baseColumnNames="ACCESSORY_ITEM_ID"
                                 referencedTableName="ACCESSORY_ITEM" referencedColumnNames="ID"
                                 constraintName="FK_RENTAL_ITEM_ACCESSORY_ON_ACCESSORY_ITEM"/>
        <addUniqueConstraint tableName="RENTAL_ITEM_ACCESSORY"
                             columnNames="RENTAL_ITEM_ID, ACCESSORY_ITEM_ID"
                             constraintName="IDX_RENTAL_ITEM_ACCESSORY_UNQ_ITEM_ACCESSORY"/>
        <createIndex tableName="RENTAL_ITEM_ACCESSORY" indexName="IDX_RENTAL_ITEM_ACCESSORY_RENTAL_ITEM">
            <column name="RENTAL_ITEM_ID"/>
        </createIndex>
        <createIndex tableName="RENTAL_ITEM_ACCESSORY" indexName="IDX_RENTAL_ITEM_ACCESSORY_ACCESSORY_ITEM">
            <column name="ACCESSORY_ITEM_ID"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026-06-28-140001-rental-item-event-accessory" author="codex">
        <createTable tableName="RENTAL_ITEM_EVENT_ACCESSORY">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_RENTAL_ITEM_EVENT_ACCESSORY"/>
            </column>
            <column name="VERSION" type="INT"/>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="TIMESTAMP"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="TIMESTAMP"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="TIMESTAMP"/>
            <column name="EVENT_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="ACCESSORY_ITEM_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="QUANTITY" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="RENTAL_ITEM_EVENT_ACCESSORY" baseColumnNames="EVENT_ID"
                                 referencedTableName="RENTAL_ITEM_EVENT" referencedColumnNames="ID"
                                 constraintName="FK_RENTAL_ITEM_EVENT_ACCESSORY_ON_EVENT"/>
        <addForeignKeyConstraint baseTableName="RENTAL_ITEM_EVENT_ACCESSORY" baseColumnNames="ACCESSORY_ITEM_ID"
                                 referencedTableName="ACCESSORY_ITEM" referencedColumnNames="ID"
                                 constraintName="FK_RENTAL_ITEM_EVENT_ACCESSORY_ON_ACCESSORY_ITEM"/>
        <addUniqueConstraint tableName="RENTAL_ITEM_EVENT_ACCESSORY"
                             columnNames="EVENT_ID, ACCESSORY_ITEM_ID"
                             constraintName="IDX_RENTAL_ITEM_EVENT_ACC_UNQ_EVENT_ACCESSORY"/>
        <createIndex tableName="RENTAL_ITEM_EVENT_ACCESSORY" indexName="IDX_RENTAL_ITEM_EVENT_ACCESSORY_EVENT">
            <column name="EVENT_ID"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
