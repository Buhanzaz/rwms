<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="2026-06-18-240000-hsqldb-drop-standalone-index" author="codex">
        <preConditions onFail="MARK_RAN">
            <dbms type="hsqldb"/>
            <tableExists tableName="REPAIR_ESTIMATE_TASK_PLAN"/>
            <sqlCheck expectedResult="1">
                SELECT COUNT(DISTINCT I.INDEX_NAME)
                FROM INFORMATION_SCHEMA.SYSTEM_INDEXINFO I
                WHERE I.TABLE_NAME = 'REPAIR_ESTIMATE_TASK_PLAN'
                  AND I.INDEX_NAME = 'IDX_REPAIR_ESTIMATE_TASK_PLAN_UNQ_GENERATED_TASK'
                  AND NOT EXISTS (
                      SELECT 1
                      FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS C
                      WHERE C.TABLE_NAME = 'REPAIR_ESTIMATE_TASK_PLAN'
                        AND C.CONSTRAINT_NAME = 'IDX_REPAIR_ESTIMATE_TASK_PLAN_UNQ_GENERATED_TASK'
                        AND C.CONSTRAINT_TYPE = 'UNIQUE'
                  )
            </sqlCheck>
        </preConditions>
        <dropIndex tableName="REPAIR_ESTIMATE_TASK_PLAN"
                   indexName="IDX_REPAIR_ESTIMATE_TASK_PLAN_UNQ_GENERATED_TASK"/>
    </changeSet>

    <changeSet id="2026-06-18-240001-hsqldb-create-unique-constraint" author="codex">
        <preConditions onFail="MARK_RAN">
            <dbms type="hsqldb"/>
            <tableExists tableName="REPAIR_ESTIMATE_TASK_PLAN"/>
            <columnExists tableName="REPAIR_ESTIMATE_TASK_PLAN" columnName="GENERATED_BOARD_TASK_ID"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS
                WHERE TABLE_NAME = 'REPAIR_ESTIMATE_TASK_PLAN'
                  AND CONSTRAINT_NAME = 'IDX_REPAIR_ESTIMATE_TASK_PLAN_UNQ_GENERATED_TASK'
                  AND CONSTRAINT_TYPE = 'UNIQUE'
            </sqlCheck>
        </preConditions>
        <addUniqueConstraint tableName="REPAIR_ESTIMATE_TASK_PLAN"
                             columnNames="GENERATED_BOARD_TASK_ID"
                             constraintName="IDX_REPAIR_ESTIMATE_TASK_PLAN_UNQ_GENERATED_TASK"/>
    </changeSet>

    <changeSet id="2026-06-18-240002-postgresql-drop-standalone-index" author="codex">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <tableExists tableName="REPAIR_ESTIMATE_TASK_PLAN"/>
            <indexExists tableName="REPAIR_ESTIMATE_TASK_PLAN"
                         indexName="IDX_REPAIR_ESTIMATE_TASK_PLAN_UNQ_GENERATED_TASK"/>
            <not>
                <uniqueConstraintExists tableName="REPAIR_ESTIMATE_TASK_PLAN"
                                        constraintName="IDX_REPAIR_ESTIMATE_TASK_PLAN_UNQ_GENERATED_TASK"/>
            </not>
        </preConditions>
        <dropIndex tableName="REPAIR_ESTIMATE_TASK_PLAN"
                   indexName="IDX_REPAIR_ESTIMATE_TASK_PLAN_UNQ_GENERATED_TASK"/>
    </changeSet>

    <changeSet id="2026-06-18-240003-postgresql-create-unique-constraint" author="codex">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <tableExists tableName="REPAIR_ESTIMATE_TASK_PLAN"/>
            <columnExists tableName="REPAIR_ESTIMATE_TASK_PLAN" columnName="GENERATED_BOARD_TASK_ID"/>
            <not>
                <uniqueConstraintExists tableName="REPAIR_ESTIMATE_TASK_PLAN"
                                        constraintName="IDX_REPAIR_ESTIMATE_TASK_PLAN_UNQ_GENERATED_TASK"/>
            </not>
        </preConditions>
        <addUniqueConstraint tableName="REPAIR_ESTIMATE_TASK_PLAN"
                             columnNames="GENERATED_BOARD_TASK_ID"
                             constraintName="IDX_REPAIR_ESTIMATE_TASK_PLAN_UNQ_GENERATED_TASK"/>
    </changeSet>

</databaseChangeLog>
