    <changeSet id="2026-07-02-purge-rental-items-and-repair-board" author="codex">
        <sql>
            UPDATE REPAIR_ESTIMATE_TASK_PLAN
            SET GENERATED_BOARD_TASK_ID = NULL,
                QUEUE_ID = NULL
            WHERE GENERATED_BOARD_TASK_ID IS NOT NULL
               OR QUEUE_ID IS NOT NULL;

            UPDATE REPAIR_ESTIMATE
            SET LATEST_EVENT_ID = NULL
            WHERE LATEST_EVENT_ID IS NOT NULL;

            DELETE FROM BOARD_TASK;
            DELETE FROM REPAIR_PROCESS;
            DELETE FROM REPAIR_ESTIMATE;
            DELETE FROM RENTAL_ITEM;
        </sql>
