<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-07-03-001000-repair-estimate-catalog-furniture-flag" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="REPAIR_ESTIMATE_CATALOG_NODE" columnName="FURNITURE_CATEGORY"/>
            </not>
        </preConditions>

        <addColumn tableName="REPAIR_ESTIMATE_CATALOG_NODE">
            <column name="FURNITURE_CATEGORY" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <update tableName="REPAIR_ESTIMATE_CATALOG_NODE">
            <column name="FURNITURE_CATEGORY" valueBoolean="true"/>
            <where>NODE_TYPE = 'CATEGORY' AND UPPER(CODE) IN ('FURNITURE', 'FURNITURE_CATEGORY')</where>
        </update>
    </changeSet>
</databaseChangeLog>
