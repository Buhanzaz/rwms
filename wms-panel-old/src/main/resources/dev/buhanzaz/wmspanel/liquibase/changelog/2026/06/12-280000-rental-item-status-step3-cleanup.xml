<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="12-280000-rental-item-status-step3-cleanup-1" author="wms-panel" context="!cuba">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="RENTAL_ITEM"/>
            <columnExists tableName="RENTAL_ITEM" columnName="STATUS"/>
        </preConditions>
        <sql>
            UPDATE RENTAL_ITEM
            SET STATUS = 'READY'
            WHERE STATUS IS NULL OR TRIM(STATUS) = '';
        </sql>
    </changeSet>

    <changeSet id="12-280000-rental-item-status-step3-cleanup-2" author="wms-panel" context="!cuba">
        <preConditions onFail="HALT">
            <tableExists tableName="RENTAL_ITEM"/>
            <columnExists tableName="RENTAL_ITEM" columnName="STATUS"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM RENTAL_ITEM
                WHERE STATUS IS NULL OR TRIM(STATUS) = '';
            </sqlCheck>
        </preConditions>
        <addNotNullConstraint tableName="RENTAL_ITEM"
                              columnName="STATUS"
                              columnDataType="VARCHAR(64)"/>
    </changeSet>

</databaseChangeLog>
