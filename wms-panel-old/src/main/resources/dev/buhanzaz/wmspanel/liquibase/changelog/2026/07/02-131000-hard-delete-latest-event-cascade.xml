<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-07-02-hard-delete-latest-event-cascade" author="codex">
        <dropForeignKeyConstraint baseTableName="REPAIR_ESTIMATE"
                                  constraintName="FK_REPAIR_ESTIMATE_ON_LATEST_EVENT"/>
        <addForeignKeyConstraint baseTableName="REPAIR_ESTIMATE"
                                 baseColumnNames="LATEST_EVENT_ID"
                                 referencedTableName="RENTAL_ITEM_EVENT"
                                 referencedColumnNames="ID"
                                 constraintName="FK_REPAIR_ESTIMATE_ON_LATEST_EVENT"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
