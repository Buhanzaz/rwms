                             columnNames="NUMBER"
                             constraintName="IDX_RENTAL_ITEM_UNQ_NUMBER"/>

        <addForeignKeyConstraint baseTableName="RENTAL_SUBCATEGORY"
                                 baseColumnNames="CATEGORY_ID"
