                                 referencedTableName="RENTAL_SUBCATEGORY"
                                 referencedColumnNames="ID"
                                 constraintName="FK_RENTAL_ITEM_ON_SUBCATEGORY"/>
        <addForeignKeyConstraint baseTableName="RENTAL_ITEM"
                                 baseColumnNames="TYPE_ID"
                                 referencedTableName="RENTAL_TYPE"
                                 referencedColumnNames="ID"
                                 constraintName="FK_RENTAL_ITEM_ON_TYPE"/>
    </changeSet>

