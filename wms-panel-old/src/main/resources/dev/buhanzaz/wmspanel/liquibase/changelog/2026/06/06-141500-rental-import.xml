<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="1" author="codex">
        <addColumn tableName="RENTAL_ITEM">
            <column name="FINISHING" type="VARCHAR(128)"/>
            <column name="SEGMENT" type="VARCHAR(64)"/>
            <column name="ELECTRICITY" type="VARCHAR(128)"/>
            <column name="BEDBUGS" type="VARCHAR(32)"/>
            <column name="LINOLEUM" type="VARCHAR(32)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2" author="codex">
        <delete tableName="RENTAL_ITEM"/>
        <delete tableName="RENTAL_TYPE"/>
        <delete tableName="RENTAL_SUBCATEGORY"/>
        <delete tableName="RENTAL_CATEGORY"/>

        <loadData file="../../../data/rental-import/rental-category.csv"
                  relativeToChangelogFile="true"
                  tableName="RENTAL_CATEGORY"
                  encoding="UTF-8"/>
        <loadData file="../../../data/rental-import/rental-subcategory.csv"
                  relativeToChangelogFile="true"
                  tableName="RENTAL_SUBCATEGORY"
                  encoding="UTF-8"/>
        <loadData file="../../../data/rental-import/rental-type.csv"
                  relativeToChangelogFile="true"
                  tableName="RENTAL_TYPE"
                  encoding="UTF-8"/>
        <loadData file="../../../data/rental-import/rental-item.csv"
                  relativeToChangelogFile="true"
                  tableName="RENTAL_ITEM"
                  encoding="UTF-8"/>
    </changeSet>
</databaseChangeLog>
