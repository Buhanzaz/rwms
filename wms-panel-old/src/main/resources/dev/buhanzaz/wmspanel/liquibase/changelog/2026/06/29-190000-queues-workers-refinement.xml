<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="2026-06-29-190000-repair-estimate-catalog-node-work-queue" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="REPAIR_ESTIMATE_CATALOG_NODE"/>
            <not>
                <columnExists tableName="REPAIR_ESTIMATE_CATALOG_NODE" columnName="WORK_QUEUE_ID"/>
            </not>
        </preConditions>
        <addColumn tableName="REPAIR_ESTIMATE_CATALOG_NODE">
            <column name="WORK_QUEUE_ID" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="REPAIR_ESTIMATE_CATALOG_NODE"
                                 baseColumnNames="WORK_QUEUE_ID"
                                 constraintName="FK_REPAIR_ESTIMATE_CATALOG_NODE_ON_WORK_QUEUE"
                                 referencedTableName="WORK_QUEUE"
                                 referencedColumnNames="ID"/>
    </changeSet>

    <changeSet id="2026-06-29-190100-work-queue-worker-group-stop-flag" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="WORK_QUEUE_WORKER_GROUP"/>
            <not>
                <columnExists tableName="WORK_QUEUE_WORKER_GROUP" columnName="STOP_TASK_ON_TAKE"/>
            </not>
        </preConditions>
        <addColumn tableName="WORK_QUEUE_WORKER_GROUP">
            <column name="STOP_TASK_ON_TAKE" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-06-29-190210-worker-app-login-field" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="WORKER"/>
            <not>
                <columnExists tableName="WORKER" columnName="APP_LOGIN"/>
            </not>
        </preConditions>
        <addColumn tableName="WORKER">
            <column name="APP_LOGIN" type="VARCHAR(128)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-06-29-190220-worker-app-password-field" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="WORKER"/>
            <not>
                <columnExists tableName="WORKER" columnName="APP_PASSWORD"/>
            </not>
        </preConditions>
        <addColumn tableName="WORKER">
            <column name="APP_PASSWORD" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-06-29-190300-worker-group-warehouse" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="WORKER_GROUP"/>
            <not>
                <columnExists tableName="WORKER_GROUP" columnName="WAREHOUSE_ID"/>
            </not>
        </preConditions>
        <addColumn tableName="WORKER_GROUP">
            <column name="WAREHOUSE_ID" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="WORKER_GROUP"
                                 baseColumnNames="WAREHOUSE_ID"
                                 constraintName="FK_WORKER_GROUP_ON_WAREHOUSE"
                                 referencedTableName="WAREHOUSE"
                                 referencedColumnNames="ID"/>
    </changeSet>

    <changeSet id="2026-06-29-190400-worker-group-member-worker" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="WORKER_GROUP_MEMBER"/>
            <not>
                <columnExists tableName="WORKER_GROUP_MEMBER" columnName="WORKER_ID"/>
            </not>
        </preConditions>
        <addColumn tableName="WORKER_GROUP_MEMBER">
            <column name="WORKER_ID" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="WORKER_GROUP_MEMBER"
                                 baseColumnNames="WORKER_ID"
                                 constraintName="FK_WORKER_GROUP_MEMBER_ON_WORKER"
                                 referencedTableName="WORKER"
                                 referencedColumnNames="ID"/>
        <addUniqueConstraint tableName="WORKER_GROUP_MEMBER"
                             columnNames="WORKER_GROUP_ID, WORKER_ID"
                             constraintName="IDX_WORKER_GROUP_MEMBER_WORKER_UNQ"/>
    </changeSet>

</databaseChangeLog>
