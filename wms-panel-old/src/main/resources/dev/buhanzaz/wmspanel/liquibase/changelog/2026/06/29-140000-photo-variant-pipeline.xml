<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-06-29-140000-rental-item-event-photo-variants" author="codex">
        <addColumn tableName="RENTAL_ITEM_EVENT_PHOTO">
            <column name="FAMILY_ROOT_KEY" type="varchar(1000)"/>
            <column name="PROCESSING_STATUS" type="varchar(32)"/>
            <column name="ORIGINAL_WIDTH" type="int"/>
            <column name="ORIGINAL_HEIGHT" type="int"/>
            <column name="PREVIEW_WIDTH" type="int"/>
            <column name="PREVIEW_HEIGHT" type="int"/>
            <column name="THUMB_WIDTH" type="int"/>
            <column name="THUMB_HEIGHT" type="int"/>
            <column name="TINY_WIDTH" type="int"/>
            <column name="TINY_HEIGHT" type="int"/>
            <column name="PROCESSING_ERROR" type="varchar(2000)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-06-29-140001-rental-item-event-photo-variants-backfill" author="codex">
        <update tableName="RENTAL_ITEM_EVENT_PHOTO">
            <column name="PROCESSING_STATUS" value="READY"/>
            <where>PROCESSING_STATUS is null</where>
        </update>
    </changeSet>

    <changeSet id="2026-06-29-140002-rental-item-event-photo-variants-indexes" author="codex">
        <createIndex tableName="RENTAL_ITEM_EVENT_PHOTO" indexName="IDX_RENTAL_ITEM_EVENT_PHOTO_STATUS">
            <column name="PROCESSING_STATUS"/>
        </createIndex>
        <createIndex tableName="RENTAL_ITEM_EVENT_PHOTO" indexName="IDX_RENTAL_ITEM_EVENT_PHOTO_FAMILY_ROOT">
            <column name="FAMILY_ROOT_KEY"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
