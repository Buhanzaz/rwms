<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="1" author="codex">
        <dropDefaultValue tableName="ACCESSORY_CATEGORY" columnName="SORT_ORDER"/>
        <dropDefaultValue tableName="ACCESSORY_SUBCATEGORY" columnName="SORT_ORDER"/>
        <dropDefaultValue tableName="ACCESSORY_ITEM" columnName="SORT_ORDER"/>

        <dropNotNullConstraint tableName="ACCESSORY_CATEGORY"
                               columnName="SORT_ORDER"
                               columnDataType="INT"/>
        <dropNotNullConstraint tableName="ACCESSORY_SUBCATEGORY"
                               columnName="SORT_ORDER"
                               columnDataType="INT"/>
        <dropNotNullConstraint tableName="ACCESSORY_ITEM"
                               columnName="SORT_ORDER"
                               columnDataType="INT"/>
    </changeSet>
</databaseChangeLog>
