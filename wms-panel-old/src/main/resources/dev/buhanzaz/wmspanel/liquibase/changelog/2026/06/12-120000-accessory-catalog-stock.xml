        <addUniqueConstraint tableName="ACCESSORY_SUBCATEGORY"
                             columnNames="CATEGORY_ID, CODE"
                             constraintName="IDX_ACCESSORY_SUBCATEGORY_UNQ_CODE"/>
        <addUniqueConstraint tableName="ACCESSORY_ITEM"
                             columnNames="SUBCATEGORY_ID, CODE"
                             constraintName="IDX_ACCESSORY_ITEM_UNQ_CODE"/>
        <addUniqueConstraint tableName="ACCESSORY_STOCK_BALANCE"
                             columnNames="WAREHOUSE_ID, ACCESSORY_ITEM_ID"
                             constraintName="IDX_ACCESSORY_STOCK_BALANCE_UNQ_WAREHOUSE_ITEM"/>

        <addForeignKeyConstraint baseTableName="ACCESSORY_SUBCATEGORY"
                                 baseColumnNames="CATEGORY_ID"
                                 referencedTableName="ACCESSORY_CATEGORY"
                                 referencedColumnNames="ID"
                                 constraintName="FK_ACCESSORY_SUBCATEGORY_ON_CATEGORY"/>
        <addForeignKeyConstraint baseTableName="ACCESSORY_ITEM"
                                 baseColumnNames="CATEGORY_ID"
                                 referencedTableName="ACCESSORY_CATEGORY"
                                 referencedColumnNames="ID"
                                 constraintName="FK_ACCESSORY_ITEM_ON_CATEGORY"/>
        <addForeignKeyConstraint baseTableName="ACCESSORY_ITEM"
                                 baseColumnNames="SUBCATEGORY_ID"
                                 referencedTableName="ACCESSORY_SUBCATEGORY"
                                 referencedColumnNames="ID"
                                 constraintName="FK_ACCESSORY_ITEM_ON_SUBCATEGORY"/>
        <addForeignKeyConstraint baseTableName="ACCESSORY_STOCK_BALANCE"
                                 baseColumnNames="WAREHOUSE_ID"
                                 referencedTableName="WAREHOUSE"
                                 referencedColumnNames="ID"
                                 constraintName="FK_ACCESSORY_STOCK_BALANCE_ON_WAREHOUSE"/>
        <addForeignKeyConstraint baseTableName="ACCESSORY_STOCK_BALANCE"
                                 baseColumnNames="ACCESSORY_ITEM_ID"
                                 referencedTableName="ACCESSORY_ITEM"
                                 referencedColumnNames="ID"
                                 constraintName="FK_ACCESSORY_STOCK_BALANCE_ON_ACCESSORY_ITEM"/>

        <createIndex tableName="ACCESSORY_SUBCATEGORY" indexName="IDX_ACCESSORY_SUBCATEGORY_ON_CATEGORY">
            <column name="CATEGORY_ID"/>
        </createIndex>
        <createIndex tableName="ACCESSORY_ITEM" indexName="IDX_ACCESSORY_ITEM_ON_CATEGORY">
            <column name="CATEGORY_ID"/>
        </createIndex>
        <createIndex tableName="ACCESSORY_ITEM" indexName="IDX_ACCESSORY_ITEM_ON_SUBCATEGORY">
            <column name="SUBCATEGORY_ID"/>
        </createIndex>
        <createIndex tableName="ACCESSORY_STOCK_BALANCE" indexName="IDX_ACCESSORY_STOCK_BALANCE_ON_WAREHOUSE">
            <column name="WAREHOUSE_ID"/>
        </createIndex>
        <createIndex tableName="ACCESSORY_STOCK_BALANCE" indexName="IDX_ACCESSORY_STOCK_BALANCE_ON_ACCESSORY_ITEM">
            <column name="ACCESSORY_ITEM_ID"/>
        </createIndex>
    </changeSet>

