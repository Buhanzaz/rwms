    <changeSet id="1" author="codex">
        <createTable tableName="ACCESSORY_CATEGORY">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ACCESSORY_CATEGORY"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="timestamp with time zone"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp with time zone"/>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="timestamp with time zone"/>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="CODE" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="ACTIVE" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="SORT_ORDER" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="COMMENT_" type="VARCHAR(1000)"/>
        </createTable>

