    <changeSet id="1" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="RESERVATION" columnName="RESERVATION_NUMBER"/>
            </not>
        </preConditions>
        <addColumn tableName="RESERVATION">
            <column name="RESERVATION_NUMBER" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

    <changeSet id="1-backfill-reservation-number" author="codex">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="RESERVATION" columnName="RESERVATION_NUMBER"/>
        </preConditions>
        <sql>
            UPDATE RESERVATION
            SET RESERVATION_NUMBER = CONCAT('R-', REPLACE(CAST(ID AS VARCHAR(36)), '-', ''))
            WHERE RESERVATION_NUMBER IS NULL OR TRIM(RESERVATION_NUMBER) = '';
        </sql>
    </changeSet>

    <changeSet id="1-not-null-reservation-number" author="codex">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="RESERVATION" columnName="RESERVATION_NUMBER"/>
        </preConditions>
        <addNotNullConstraint tableName="RESERVATION" columnName="RESERVATION_NUMBER" columnDataType="VARCHAR(64)"/>
    </changeSet>

