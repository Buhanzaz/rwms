<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-07-03-143001-clean-duplicate-accessory-furniture-links" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="ACCESSORY_ITEM"/>
            <columnExists tableName="ACCESSORY_ITEM" columnName="FURNITURE_MATERIAL_ID"/>
        </preConditions>
        <sql>
            update ACCESSORY_ITEM ai
            set FURNITURE_MATERIAL_ID = null
            where FURNITURE_MATERIAL_ID is not null
              and ID &lt;&gt; (
                  select min(ai2.ID)
                  from ACCESSORY_ITEM ai2
                  where ai2.FURNITURE_MATERIAL_ID = ai.FURNITURE_MATERIAL_ID
              )
        </sql>
    </changeSet>

    <changeSet id="2026-07-03-143002-unique-accessory-furniture-link" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="ACCESSORY_ITEM"/>
            <columnExists tableName="ACCESSORY_ITEM" columnName="FURNITURE_MATERIAL_ID"/>
            <not>
                <uniqueConstraintExists tableName="ACCESSORY_ITEM"
                                        constraintName="IDX_ACCESSORY_ITEM_UNQ_FURNITURE_MATERIAL"/>
            </not>
        </preConditions>
        <addUniqueConstraint tableName="ACCESSORY_ITEM"
                             columnNames="FURNITURE_MATERIAL_ID"
                             constraintName="IDX_ACCESSORY_ITEM_UNQ_FURNITURE_MATERIAL"/>
    </changeSet>

</databaseChangeLog>
