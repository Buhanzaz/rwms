    <changeSet id="2-worker-class-seed-adjustment" author="codex">
        <validCheckSum>9:5f41a002e4d8b87dbf7d902db8111baf</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="WORKER_CLASS"/>
        </preConditions>
        <sql>
            UPDATE WORKER_CLASS
               SET CODE = 'DRIVER',
                   NAME = CASE WHEN NAME = 'Водители' OR NAME IS NULL THEN 'Водитель' ELSE NAME END,
                   SORT_ORDER = CASE WHEN SORT_ORDER = 10 OR SORT_ORDER IS NULL THEN 10 ELSE SORT_ORDER END
             WHERE CODE = 'DRIVERS'
               AND NOT EXISTS (SELECT 1 FROM WORKER_CLASS WHERE CODE = 'DRIVER');

            UPDATE WORKER_CLASS
               SET CODE = 'RIGGER',
                   NAME = CASE WHEN NAME = 'Стропальщики' OR NAME IS NULL THEN 'Стропальщик' ELSE NAME END,
                   SORT_ORDER = CASE WHEN SORT_ORDER = 60 OR SORT_ORDER IS NULL THEN 20 ELSE SORT_ORDER END
             WHERE CODE = 'SLINGERS'
               AND NOT EXISTS (SELECT 1 FROM WORKER_CLASS WHERE CODE = 'RIGGER');

            UPDATE WORKER_CLASS
               SET CODE = 'GENERAL_WORKER',
                   NAME = CASE WHEN NAME = 'Разнорабочие' OR NAME IS NULL THEN 'Разнорабочий' ELSE NAME END,
                   SORT_ORDER = CASE WHEN SORT_ORDER = 50 OR SORT_ORDER IS NULL THEN 30 ELSE SORT_ORDER END
             WHERE CODE = 'WORKERS'
               AND NOT EXISTS (SELECT 1 FROM WORKER_CLASS WHERE CODE = 'GENERAL_WORKER');

            UPDATE WORKER_CLASS
               SET CODE = 'ELECTRICIAN',
                   NAME = CASE WHEN NAME = 'Электрики' OR NAME IS NULL THEN 'Электрик' ELSE NAME END,
                   SORT_ORDER = CASE WHEN SORT_ORDER = 40 OR SORT_ORDER IS NULL THEN 40 ELSE SORT_ORDER END
             WHERE CODE = 'ELECTRICIANS'
               AND NOT EXISTS (SELECT 1 FROM WORKER_CLASS WHERE CODE = 'ELECTRICIAN');

            UPDATE WORKER_CLASS
               SET CODE = 'PLUMBER',
                   NAME = CASE WHEN NAME = 'Сантехники' OR NAME IS NULL THEN 'Сантехник' ELSE NAME END,
                   SORT_ORDER = CASE WHEN SORT_ORDER = 30 OR SORT_ORDER IS NULL THEN 50 ELSE SORT_ORDER END
             WHERE CODE = 'PLUMBERS'
               AND NOT EXISTS (SELECT 1 FROM WORKER_CLASS WHERE CODE = 'PLUMBER');

            UPDATE WORKER_CLASS
               SET NAME = CASE WHEN NAME = 'СЭС' OR NAME IS NULL THEN 'СЭС' ELSE NAME END,
                   SORT_ORDER = CASE WHEN SORT_ORDER = 20 OR SORT_ORDER IS NULL THEN 70 ELSE SORT_ORDER END
             WHERE CODE = 'SES';
        </sql>
    </changeSet>

