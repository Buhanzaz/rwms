    <changeSet id="2026-07-01-151000-price-items-parent-doors" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="REPAIR_ESTIMATE_CATALOG_NODE"/>
            <sqlCheck expectedResult="1"><![CDATA[
                SELECT COUNT(*) FROM REPAIR_ESTIMATE_CATALOG_NODE WHERE CODE = 'DOORS'
            ]]></sqlCheck>
        </preConditions>
        <update tableName="REPAIR_ESTIMATE_CATALOG_NODE">
            <column name="PARENT_ID" valueComputed="(SELECT ID FROM REPAIR_ESTIMATE_CATALOG_NODE WHERE CODE = 'DOORS')"/>
