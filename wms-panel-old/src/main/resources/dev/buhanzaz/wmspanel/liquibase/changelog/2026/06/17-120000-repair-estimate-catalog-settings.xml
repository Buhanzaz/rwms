            <column name="ACTIVE"/>
        </createIndex>
    </changeSet>

    <changeSet id="12-link-index-source" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="IDX_REPAIR_ESTIMATE_CATALOG_LINK_ON_SOURCE"
                             tableName="REPAIR_ESTIMATE_CATALOG_LINK"/>
            </not>
        </preConditions>
        <createIndex tableName="REPAIR_ESTIMATE_CATALOG_LINK"
                     indexName="IDX_REPAIR_ESTIMATE_CATALOG_LINK_ON_SOURCE">
            <column name="SOURCE_NODE_ID"/>
        </createIndex>
    </changeSet>

    <changeSet id="13-link-index-target" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="IDX_REPAIR_ESTIMATE_CATALOG_LINK_ON_TARGET"
                             tableName="REPAIR_ESTIMATE_CATALOG_LINK"/>
            </not>
        </preConditions>
        <createIndex tableName="REPAIR_ESTIMATE_CATALOG_LINK"
                     indexName="IDX_REPAIR_ESTIMATE_CATALOG_LINK_ON_TARGET">
