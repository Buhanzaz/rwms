                                            foreignKeyName="FK_REPAIR_ESTIMATE_CATALOG_LINK_ON_SOURCE"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseTableName="REPAIR_ESTIMATE_CATALOG_LINK"
                                 baseColumnNames="SOURCE_NODE_ID"
                                 referencedTableName="REPAIR_ESTIMATE_CATALOG_NODE"
                                 referencedColumnNames="ID"
                                 constraintName="FK_REPAIR_ESTIMATE_CATALOG_LINK_ON_SOURCE"/>
    </changeSet>

    <changeSet id="7-link-target-fk" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyTableName="REPAIR_ESTIMATE_CATALOG_LINK"
                                            foreignKeyName="FK_REPAIR_ESTIMATE_CATALOG_LINK_ON_TARGET"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseTableName="REPAIR_ESTIMATE_CATALOG_LINK"
                                 baseColumnNames="TARGET_NODE_ID"
                                 referencedTableName="REPAIR_ESTIMATE_CATALOG_NODE"
                                 referencedColumnNames="ID"
                                 constraintName="FK_REPAIR_ESTIMATE_CATALOG_LINK_ON_TARGET"/>
    </changeSet>

    <changeSet id="8-node-index-parent" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="IDX_REPAIR_ESTIMATE_CATALOG_NODE_ON_PARENT"
                             tableName="REPAIR_ESTIMATE_CATALOG_NODE"/>
            </not>
        </preConditions>
        <createIndex tableName="REPAIR_ESTIMATE_CATALOG_NODE"
                     indexName="IDX_REPAIR_ESTIMATE_CATALOG_NODE_ON_PARENT">
            <column name="PARENT_ID"/>
        </createIndex>
    </changeSet>

    <changeSet id="9-node-index-sort-order" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="IDX_REPAIR_ESTIMATE_CATALOG_NODE_ON_SORT_ORDER"
