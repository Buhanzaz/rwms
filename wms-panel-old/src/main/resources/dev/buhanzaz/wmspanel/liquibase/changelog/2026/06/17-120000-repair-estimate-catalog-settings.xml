            <column name="SORT_ORDER"/>
        </createIndex>
    </changeSet>

    <changeSet id="10-node-index-node-type" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="IDX_REPAIR_ESTIMATE_CATALOG_NODE_ON_NODE_TYPE"
                             tableName="REPAIR_ESTIMATE_CATALOG_NODE"/>
            </not>
        </preConditions>
        <createIndex tableName="REPAIR_ESTIMATE_CATALOG_NODE"
