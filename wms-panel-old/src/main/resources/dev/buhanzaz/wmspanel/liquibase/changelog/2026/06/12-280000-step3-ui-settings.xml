<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="12-280000-step3-ui-settings-1" author="wms-panel" context="!cuba">
        <createTable tableName="USER_GRID_COLUMN_SETTINGS">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_USER_GRID_COLUMN_SETTINGS"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="timestamp with time zone"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp with time zone"/>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="timestamp with time zone"/>
            <column name="USER_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="GRID_CODE" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="COLUMN_KEY" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="VISIBLE" type="BOOLEAN"/>
            <column name="SORT_ORDER" type="INT"/>
            <column name="WIDTH" type="VARCHAR(32)"/>
        </createTable>

        <addUniqueConstraint tableName="USER_GRID_COLUMN_SETTINGS"
                             columnNames="USER_ID, GRID_CODE, COLUMN_KEY"
                             constraintName="IDX_USER_GRID_COLUMN_SETTINGS_UNQ"/>
        <addForeignKeyConstraint baseTableName="USER_GRID_COLUMN_SETTINGS"
                                 baseColumnNames="USER_ID"
                                 referencedTableName="USER_"
                                 referencedColumnNames="ID"
                                 constraintName="FK_USER_GRID_COLUMN_SETTINGS_ON_USER"/>
        <createIndex tableName="USER_GRID_COLUMN_SETTINGS" indexName="IDX_USER_GRID_COLUMN_SETTINGS_ON_USER_ID">
            <column name="USER_ID"/>
        </createIndex>
    </changeSet>

