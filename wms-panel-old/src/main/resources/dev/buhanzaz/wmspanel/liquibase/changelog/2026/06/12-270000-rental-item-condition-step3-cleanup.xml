<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="12-270000-rental-item-condition-step3-cleanup-1" author="wms-panel" context="!cuba">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="RENTAL_ITEM_CONDITION"/>
            </not>
        </preConditions>
        <createTable tableName="RENTAL_ITEM_CONDITION">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_RENTAL_ITEM_CONDITION"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="timestamp with time zone"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp with time zone"/>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="timestamp with time zone"/>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="CODE" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="ACTIVE" type="BOOLEAN"/>
            <column name="SORT_ORDER" type="INT"/>
        </createTable>

        <addUniqueConstraint tableName="RENTAL_ITEM_CONDITION"
                             columnNames="CODE"
                             constraintName="IDX_RENTAL_ITEM_CONDITION_UNQ_CODE"/>

        <insert tableName="RENTAL_ITEM_CONDITION">
            <column name="ID" value="66666666-6666-6666-6666-666666666601"/>
            <column name="VERSION" valueNumeric="0"/>
            <column name="NAME" value="Отличное"/>
            <column name="CODE" value="EXCELLENT"/>
            <column name="ACTIVE" valueBoolean="true"/>
            <column name="SORT_ORDER" valueNumeric="10"/>
        </insert>
        <insert tableName="RENTAL_ITEM_CONDITION">
            <column name="ID" value="66666666-6666-6666-6666-666666666602"/>
            <column name="VERSION" valueNumeric="0"/>
            <column name="NAME" value="Хорошее"/>
            <column name="CODE" value="GOOD"/>
            <column name="ACTIVE" valueBoolean="true"/>
            <column name="SORT_ORDER" valueNumeric="20"/>
        </insert>
        <insert tableName="RENTAL_ITEM_CONDITION">
            <column name="ID" value="66666666-6666-6666-6666-666666666603"/>
            <column name="VERSION" valueNumeric="0"/>
            <column name="NAME" value="Удовлетворительное"/>
            <column name="CODE" value="SATISFACTORY"/>
            <column name="ACTIVE" valueBoolean="true"/>
            <column name="SORT_ORDER" valueNumeric="30"/>
        </insert>
        <insert tableName="RENTAL_ITEM_CONDITION">
            <column name="ID" value="66666666-6666-6666-6666-666666666604"/>
            <column name="VERSION" valueNumeric="0"/>
            <column name="NAME" value="Требует ремонта"/>
            <column name="CODE" value="NEEDS_REPAIR"/>
            <column name="ACTIVE" valueBoolean="true"/>
            <column name="SORT_ORDER" valueNumeric="40"/>
        </insert>
    </changeSet>

    <changeSet id="12-270000-rental-item-condition-step3-cleanup-2" author="wms-panel" context="!cuba">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="RENTAL_ITEM"/>
            <not>
                <columnExists tableName="RENTAL_ITEM" columnName="CONDITION_ID"/>
            </not>
        </preConditions>
        <addColumn tableName="RENTAL_ITEM">
            <column name="CONDITION_ID" type="UUID"/>
        </addColumn>
    </changeSet>

    <changeSet id="12-270000-rental-item-condition-step3-cleanup-3" author="wms-panel" context="!cuba">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="RENTAL_ITEM"/>
            <columnExists tableName="RENTAL_ITEM" columnName="CONDITION_ID"/>
            <tableExists tableName="RENTAL_ITEM_CONDITION"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="FK_RENTAL_ITEM_ON_CONDITION"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseTableName="RENTAL_ITEM"
                                 baseColumnNames="CONDITION_ID"
                                 referencedTableName="RENTAL_ITEM_CONDITION"
                                 referencedColumnNames="ID"
                                 constraintName="FK_RENTAL_ITEM_ON_CONDITION"/>
        <createIndex tableName="RENTAL_ITEM" indexName="IDX_RENTAL_ITEM_ON_CONDITION">
            <column name="CONDITION_ID"/>
        </createIndex>
    </changeSet>

    <changeSet id="12-270000-rental-item-condition-step3-cleanup-4" author="wms-panel" context="!cuba">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="RENTAL_ITEM_CONDITION"/>
            <not>
                <columnExists tableName="RENTAL_ITEM_CONDITION" columnName="COMMENT_"/>
            </not>
        </preConditions>
        <addColumn tableName="RENTAL_ITEM_CONDITION">
            <column name="COMMENT_" type="VARCHAR(1000)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
