<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://RentalSubcategoryDetailView.title"
      focusComponent="form">
    <data>
        <instance id="rentalSubcategoryDc"
                  class="dev.buhanzaz.wmspanel.entity.RentalSubcategory">
            <fetchPlan extends="_base">
                <property name="category" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
        <collection id="rentalCategoriesDc"
                    class="dev.buhanzaz.wmspanel.entity.RentalCategory">
            <fetchPlan extends="_base"/>
            <loader id="rentalCategoriesDl" readOnly="true">
                <query>
                    <![CDATA[select e from RentalCategory e order by e.sortOrder, e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <formLayout id="form" dataContainer="rentalSubcategoryDc">
            <entityComboBox id="categoryField" property="category" itemsContainer="rentalCategoriesDc" required="true"/>
            <textField id="nameField" property="name" required="true"/>
            <textField id="codeField" property="code" required="true"/>
            <checkbox id="activeField" property="active"/>
            <integerField id="sortOrderField" property="sortOrder"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
