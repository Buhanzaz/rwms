<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://WarehouseListView.title"
      focusComponent="warehousesDataGrid">
    <data>
        <collection id="warehousesDc" class="dev.buhanzaz.wmspanel.entity.Warehouse">
            <fetchPlan extends="_base"/>
            <loader id="warehousesDl" readOnly="true">
                <query><![CDATA[select e from Warehouse e order by e.sortOrder, e.name]]></query>
            </loader>
        </collection>
    </data>
    <facets><dataLoadCoordinator auto="true"/></facets>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="warehousesDataGrid.createAction"/>
                <button id="editButton" action="warehousesDataGrid.editAction"/>
                <button id="removeButton" action="warehousesDataGrid.removeAction"/>
            </startSlot>
        </hbox>
        <dataGrid id="warehousesDataGrid" width="100%" minHeight="20em" dataContainer="warehousesDc">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="name"/>
                <column property="code"/>
                <column property="city"/>
                <column property="address"/>
                <column property="timeZone"/>
                <column property="active"/>
                <column property="sortOrder"/>
                <column property="comment"/>
            </columns>
        </dataGrid>
    </layout>
</view>
