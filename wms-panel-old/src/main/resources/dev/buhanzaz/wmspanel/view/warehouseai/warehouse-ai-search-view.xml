<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dev.buhanzaz.wmspanel.view.warehouseai/WarehouseAiSearchView.title"
      focusComponent="searchField">
    <data>
        <keyValueCollection id="searchResultsDc">
            <loader id="searchResultsDl"/>
            <properties>
                <property name="entityId" datatype="uuid"/>
                <property name="warehouseId" datatype="uuid"/>
                <property name="sourceType" datatype="string"/>
                <property name="itemType" datatype="string"/>
                <property name="warehouse" datatype="string"/>
                <property name="number" datatype="string"/>
                <property name="name" datatype="string"/>
                <property name="segment" datatype="string"/>
                <property name="type" datatype="string"/>
                <property name="category" datatype="string"/>
                <property name="status" datatype="string"/>
                <property name="total" datatype="int"/>
                <property name="reserved" datatype="int"/>
                <property name="available" datatype="int"/>
                <property name="comment" datatype="string"/>
            </properties>
        </keyValueCollection>
    </data>
    <layout>
        <vbox id="searchPane" spacing="true" padding="false" width="100%">
            <hbox id="searchBar" alignItems="END" spacing="true">
                <textField id="searchField" label="AI-поиск" width="40em"/>
                <button id="searchButton" text="Поиск"/>
            </hbox>
            <div id="searchHint"/>
            <dataGrid id="searchResultsDataGrid"
                      width="100%"
                      height="100%"
                      minHeight="24em"
                      dataContainer="searchResultsDc"
                      pageSize="50"
                      columnReorderingAllowed="true"
                      themeNames="column-borders row-stripes compact">
                <columns resizable="true">
                    <column property="warehouse" header="Склад"/>
                    <column property="itemType" header="Тип позиции"/>
                    <column property="number" header="Номер"/>
                    <column property="name" header="Наименование"/>
                    <column property="segment" header="Сегмент / категория"/>
                    <column property="type" header="Тип"/>
                    <column property="category" header="Категория"/>
                    <column property="status" header="Статус"/>
                    <column property="total" header="Всего"/>
                    <column property="reserved" header="В резерве"/>
                    <column property="available" header="Доступно"/>
                    <column property="comment" header="Комментарий"/>
                    <column key="actions" header="Действия"/>
                </columns>
            </dataGrid>
        </vbox>
    </layout>
</view>
