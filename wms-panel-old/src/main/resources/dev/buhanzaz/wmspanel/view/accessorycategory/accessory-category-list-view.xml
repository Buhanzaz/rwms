<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://AccessoryCategoryListView.title"
      focusComponent="accessoryCategoriesDataGrid">
    <data>
        <collection id="accessoryCategoriesDc" class="dev.buhanzaz.wmspanel.entity.AccessoryCategory">
            <fetchPlan extends="_base"/>
            <loader id="accessoryCategoriesDl" readOnly="true">
                <query><![CDATA[select e from AccessoryCategory e order by coalesce(e.sortOrder, 2147483647), e.name]]></query>
            </loader>
        </collection>
    </data>
    <facets><dataLoadCoordinator auto="true"/></facets>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="accessoryCategoriesDataGrid.createAction"/>
                <button id="editButton" action="accessoryCategoriesDataGrid.editAction"/>
                <button id="removeButton" action="accessoryCategoriesDataGrid.removeAction"/>
            </startSlot>
        </hbox>
        <dataGrid id="accessoryCategoriesDataGrid" width="100%" minHeight="20em" dataContainer="accessoryCategoriesDc">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="name"/>
                <column property="code"/>
                <column property="active"/>
                <column property="sortOrder"/>
                <column property="comment"/>
            </columns>
        </dataGrid>
    </layout>
</view>
