<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://WorkQueueDetailView.title" focusComponent="form">
    <data>
        <instance id="workQueueDc" class="dev.buhanzaz.wmspanel.entity.WorkQueue">
            <fetchPlan extends="_base">
                <property name="warehouse" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
        <collection id="warehousesDc" class="dev.buhanzaz.wmspanel.entity.Warehouse">
            <fetchPlan extends="_base"/>
            <loader id="warehousesDl" readOnly="true">
                <query><![CDATA[select e from Warehouse e where e.active = true order by e.name]]></query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <formLayout id="form" dataContainer="workQueueDc">
            <entityComboBox id="warehouseField" property="warehouse" itemsContainer="warehousesDc" required="true"/>
            <textField id="codeField" property="code" required="true"/>
            <textField id="nameField" property="name" required="true"/>
            <comboBox id="queueKindField" property="queueKind" required="true"/>
            <textArea id="descriptionField" property="description"/>
            <integerField id="sortOrderField" property="sortOrder"/>
            <checkbox id="activeField" property="active"/>
            <checkbox id="collapsedField" property="collapsed"/>
            <checkbox id="hiddenField" property="hidden"/>
            <checkbox id="sinkQueueField" property="sinkQueue"/>
            <integerField id="holdingPeriodField" property="holdingPeriodMinutes"/>
            <integerField id="notificationThresholdField" property="notificationThreshold"/>
            <checkbox id="notifyWhenThresholdReachedField" property="notifyWhenThresholdReached"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
