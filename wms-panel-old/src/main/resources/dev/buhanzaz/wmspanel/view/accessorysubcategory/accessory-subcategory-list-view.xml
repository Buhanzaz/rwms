<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://AccessorySubcategoryListView.title"
      focusComponent="accessorySubcategoriesDataGrid">
    <data>
        <collection id="accessorySubcategoriesDc" class="dev.buhanzaz.wmspanel.entity.AccessorySubcategory">
            <fetchPlan extends="_base">
                <property name="category" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="accessorySubcategoriesDl" readOnly="true">
                <query><![CDATA[select e from AccessorySubcategory e order by e.category.name, coalesce(e.sortOrder, 2147483647), e.name]]></query>
            </loader>
        </collection>
    </data>
    <facets><dataLoadCoordinator auto="true"/></facets>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="accessorySubcategoriesDataGrid.createAction"/>
                <button id="editButton" action="accessorySubcategoriesDataGrid.editAction"/>
                <button id="removeButton" action="accessorySubcategoriesDataGrid.removeAction"/>
            </startSlot>
        </hbox>
        <dataGrid id="accessorySubcategoriesDataGrid" width="100%" minHeight="20em" dataContainer="accessorySubcategoriesDc">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="category"/>
                <column property="name"/>
                <column property="code"/>
                <column property="active"/>
                <column property="sortOrder"/>
                <column property="comment"/>
            </columns>
        </dataGrid>
    </layout>
</view>
