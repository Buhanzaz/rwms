<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://AccessoryItemListView.title"
      focusComponent="accessoryItemsDataGrid">
    <data>
        <collection id="accessoryItemsDc" class="dev.buhanzaz.wmspanel.entity.AccessoryItem">
            <fetchPlan extends="_base">
                <property name="category" fetchPlan="_base"/>
                <property name="subcategory" fetchPlan="_base"/>
                <property name="furnitureMaterial" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="accessoryItemsDl" readOnly="true">
                <query><![CDATA[select e from AccessoryItem e order by e.category.name, e.subcategory.name, coalesce(e.sortOrder, 2147483647), e.name]]></query>
            </loader>
        </collection>
    </data>
    <facets><dataLoadCoordinator auto="true"/></facets>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="accessoryItemsDataGrid.createAction"/>
                <button id="editButton" action="accessoryItemsDataGrid.editAction"/>
                <button id="removeButton" action="accessoryItemsDataGrid.removeAction"/>
            </startSlot>
        </hbox>
        <dataGrid id="accessoryItemsDataGrid" width="100%" minHeight="20em" dataContainer="accessoryItemsDc">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="category"/>
                <column property="subcategory"/>
                <column property="name"/>
                <column property="code"/>
                <column property="furnitureMaterial"/>
                <column property="active"/>
                <column property="sortOrder"/>
                <column property="comment"/>
            </columns>
        </dataGrid>
    </layout>
</view>
