<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://UserWarehouseAccessDetailView.title"
      focusComponent="form">
    <data>
        <instance id="userWarehouseAccessDc"
                  class="dev.buhanzaz.wmspanel.entity.UserWarehouseAccess">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_base"/>
                <property name="warehouse" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
        <collection id="usersDc"
                    class="dev.buhanzaz.wmspanel.entity.User">
            <fetchPlan extends="_base"/>
            <loader readOnly="true">
                <query>
                    <![CDATA[select e from wmspanel_User e order by e.username]]>
                </query>
            </loader>
        </collection>
        <collection id="warehousesDc"
                    class="dev.buhanzaz.wmspanel.entity.Warehouse">
            <fetchPlan extends="_base"/>
            <loader readOnly="true">
                <query>
                    <![CDATA[select e from Warehouse e where e.active = true order by coalesce(e.sortOrder, 999999), e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <formLayout id="form" dataContainer="userWarehouseAccessDc">
            <entityComboBox id="userField" property="user" itemsContainer="usersDc" clearButtonVisible="true" required="true"/>
            <entityComboBox id="warehouseField" property="warehouse" itemsContainer="warehousesDc" required="true"/>
            <comboBox id="accessLevelField" property="accessLevel" clearButtonVisible="true" required="true"/>
            <textArea id="commentField" property="comment"/>
            <checkbox id="activeField" property="active"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
