<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://RentalItemListView.title"
      focusComponent="rentalItemsDataGrid">
    <data>
        <collection id="rentalItemsDc"
                    class="dev.buhanzaz.wmspanel.entity.RentalItem">
            <fetchPlan extends="_base">
                <property name="warehouse" fetchPlan="_base"/>
                <property name="category" fetchPlan="_base"/>
                <property name="subcategory" fetchPlan="_base"/>
                <property name="type" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="rentalItemsDl" readOnly="true">
                <query>
                    <![CDATA[select e from RentalItem e
                    where :loadAllowed = true
                      and (:warehouse is null or e.warehouse = :warehouse)
                      and (:category is null or e.category = :category)
                      and (:subcategory is null or e.subcategory = :subcategory)
                      and (:type is null or e.type = :type)
                      and (:status is null or e.status = :status)
                    order by e.number]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <split id="warehouseSplit"
               width="100%"
               height="100%"
               orientation="HORIZONTAL"
               splitterPosition="74"
               themeNames="small">
            <vbox id="gridPane"
                  spacing="true"
                  padding="false"
                  height="100%">
                <hbox id="warehouseBar" alignItems="CENTER" spacing="true">
                    <comboBox id="warehouseSelector" label="Терминал"/>
                </hbox>
                <hbox id="filtersBar" alignItems="CENTER" spacing="true">
                    <comboBox id="filterCategoryField" label="Категория"/>
                    <comboBox id="filterSubcategoryField" label="Класс"/>
                    <comboBox id="filterTypeField" label="Тип"/>
                    <comboBox id="filterStatusField" label="Статус"/>
                </hbox>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <startSlot>
                        <button id="refreshButton" text="Обновить"/>
                        <button id="createButton" text="Добавить объект"/>
                        <button id="resetFiltersButton" text="Сбросить все фильтры"/>
                        <button id="columnSettingsButton" text="Настроить столбцы"/>
                        <button id="removeButton" action="rentalItemsDataGrid.removeAction"/>
                    </startSlot>
                </hbox>
                <dataGrid id="rentalItemsDataGrid"
                          width="100%"
                          height="100%"
                          minHeight="20em"
                          pageSize="50"
                          dataContainer="rentalItemsDc"
                          columnReorderingAllowed="true"
                          themeNames="column-borders row-stripes compact">
                    <actions>
                        <action id="removeAction" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column key="number" property="number"/>
                        <column key="status" property="status"/>
                        <column key="warehouse" property="warehouse"/>
                        <column key="category" property="category"/>
                        <column key="subcategory" property="subcategory"/>
                        <column key="type" property="type"/>
                        <column key="comment" property="comment"/>
                        <column key="lastModifiedDate" property="lastModifiedDate"/>
                        <column key="lastModifiedBy" property="lastModifiedBy"/>
                    </columns>
                </dataGrid>
            </vbox>
            <vbox id="detailsPane"
                  classNames="warehouse-details"
                  spacing="true"
                  padding="true"
                  height="100%"
                  visible="false">
                <h3 text="Карточка позиции"/>
                <vbox id="detailsHistoryPane"
                      spacing="true"
                      padding="false"/>
                <hbox id="detailsActionsRow" spacing="true">
                    <button id="detailsEditButton" text="Изменить"/>
                    <button id="detailsHistoryButton" text="История"/>
                    <button id="detailsSaveButton" text="Сохранить" visible="false"/>
                    <button id="detailsCancelButton" text="Отмена" visible="false"/>
                </hbox>
                <formLayout id="detailsSummaryForm"
                            width="100%">
                    <textField id="detailsNumberField" label="Номер"/>
                    <comboBox id="detailsWarehouseField" label="Склад"/>
                    <comboBox id="detailsStatusField" label="Статус"/>
                    <comboBox id="detailsCategoryField" label="Категория"/>
                    <comboBox id="detailsSubcategoryField" label="Класс"/>
                    <comboBox id="detailsTypeField" label="Тип"/>
                    <textField id="detailsLastModifiedDateField" label="Дата изменения"/>
                    <textField id="detailsLastModifiedByField" label="Кто изменил"/>
                    <textArea id="detailsCommentField" label="Комментарий"/>
                </formLayout>
                <vbox id="detailsEditablePane"
                      width="100%"
                      spacing="true"
                      padding="false"
                      visible="false"/>
                <vbox id="detailsPassportPane"
                      spacing="true"
                      padding="false"/>
            </vbox>
        </split>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
