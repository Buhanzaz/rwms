<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://AccessorySubcategoryDetailView.title"
      focusComponent="form">
    <data>
        <instance id="accessorySubcategoryDc" class="dev.buhanzaz.wmspanel.entity.AccessorySubcategory">
            <fetchPlan extends="_base">
                <property name="category" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
        <collection id="accessoryCategoriesDc" class="dev.buhanzaz.wmspanel.entity.AccessoryCategory">
            <fetchPlan extends="_base"/>
            <loader id="accessoryCategoriesDl" readOnly="true">
                <query><![CDATA[select e from AccessoryCategory e where e.active = true order by e.sortOrder, e.name]]></query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets><dataLoadCoordinator auto="true"/></facets>
    <layout>
        <formLayout id="form" dataContainer="accessorySubcategoryDc">
            <entityComboBox id="categoryField" property="category" itemsContainer="accessoryCategoriesDc" required="true"/>
            <textField id="nameField" property="name" required="true"/>
            <textField id="codeField" property="code" required="true"/>
            <checkbox id="activeField" property="active"/>
            <integerField id="sortOrderField" property="sortOrder"/>
            <textArea id="commentField" property="comment"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
