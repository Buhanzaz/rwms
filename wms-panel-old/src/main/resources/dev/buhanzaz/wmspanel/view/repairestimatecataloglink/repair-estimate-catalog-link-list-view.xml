<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://RepairEstimateCatalogLinkListView.title"
      focusComponent="repairEstimateCatalogLinksDataGrid">
    <data>
        <collection id="repairEstimateCatalogLinksDc" class="dev.buhanzaz.wmspanel.entity.RepairEstimateCatalogLink">
            <fetchPlan extends="_base">
                <property name="sourceNode" fetchPlan="_base"/>
                <property name="targetNode" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="repairEstimateCatalogLinksDl" readOnly="true">
                <query><![CDATA[
                    select e from RepairEstimateCatalogLink e
                    order by coalesce(e.sortOrder, 2147483647), e.linkType, e.id
                ]]></query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="repairEstimateCatalogLinksDataGrid.createAction"/>
                <button id="editButton" action="repairEstimateCatalogLinksDataGrid.editAction"/>
                <button id="removeButton" action="repairEstimateCatalogLinksDataGrid.removeAction"/>
            </startSlot>
        </hbox>
        <dataGrid id="repairEstimateCatalogLinksDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="repairEstimateCatalogLinksDc">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="sourceNode"/>
                <column property="targetNode"/>
                <column property="linkType"/>
                <column property="active"/>
                <column property="sortOrder"/>
                <column property="comment"/>
            </columns>
        </dataGrid>
    </layout>
</view>
