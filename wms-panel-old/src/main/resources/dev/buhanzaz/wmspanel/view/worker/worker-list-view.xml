<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://WorkerListView.title" focusComponent="workersDataGrid">
    <data>
        <collection id="workersDc" class="dev.buhanzaz.wmspanel.entity.Worker">
            <fetchPlan extends="_base">
                <property name="warehouse" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="workersDl" readOnly="true">
                <query><![CDATA[
                    select e from Worker e
                    where e.warehouse.id in :warehouseIds
                    order by e.warehouse.sortOrder, e.warehouse.name, e.lastName, e.firstName, e.middleName, e.id
                ]]></query>
            </loader>
        </collection>
    </data>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="workersDataGrid.createAction"/>
                <button id="editButton" action="workersDataGrid.editAction"/>
                <button id="removeButton" action="workersDataGrid.removeAction"/>
            </startSlot>
        </hbox>
        <dataGrid id="workersDataGrid" width="100%" minHeight="20em" dataContainer="workersDc">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
        </dataGrid>
    </layout>
</view>
