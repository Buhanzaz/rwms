<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://UserWarehouseAccessListView.title"
      focusComponent="userWarehouseAccessesDataGrid">
    <data>
        <collection id="userWarehouseAccessesDc"
                    class="dev.buhanzaz.wmspanel.entity.UserWarehouseAccess">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_base"/>
                <property name="warehouse" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="userWarehouseAccessesDl" readOnly="true">
                <query>
                    <![CDATA[select e from UserWarehouseAccess e order by e.user.username, e.warehouse.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="userWarehouseAccessesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="userWarehouseAccessesDataGrid.createAction"/>
                <button id="editButton" action="userWarehouseAccessesDataGrid.editAction"/>
                <button id="removeButton" action="userWarehouseAccessesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="userWarehouseAccessesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="userWarehouseAccessesDataGrid"
                  width="100%"
                  columnReorderingAllowed="true"
                  minHeight="20em"
                  dataContainer="userWarehouseAccessesDc">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="user"/>
                <column property="warehouse"/>
                <column property="accessLevel"/>
                <column property="comment"/>
                <column property="active"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
