<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://UserGridColumnSettingsListView.title"
      focusComponent="userGridColumnSettingsDataGrid">
    <data>
        <collection id="userGridColumnSettingsDc"
                    class="dev.buhanzaz.wmspanel.entity.UserGridColumnSettings">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="userGridColumnSettingsDl" readOnly="true">
                <query>
                    <![CDATA[select e from UserGridColumnSettings e order by e.user.username, e.gridCode, e.sortOrder, e.columnKey]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="userGridColumnSettingsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="userGridColumnSettingsDataGrid.createAction"/>
                <button id="editButton" action="userGridColumnSettingsDataGrid.editAction"/>
                <button id="removeButton" action="userGridColumnSettingsDataGrid.removeAction"/>
            </startSlot>
        </hbox>
        <dataGrid id="userGridColumnSettingsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="userGridColumnSettingsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="user"/>
                <column property="gridCode"/>
                <column property="columnKey"/>
                <column property="visible"/>
                <column property="sortOrder"/>
                <column property="width"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
