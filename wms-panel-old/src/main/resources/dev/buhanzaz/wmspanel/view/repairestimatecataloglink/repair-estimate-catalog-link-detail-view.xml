<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://RepairEstimateCatalogLinkDetailView.title"
      focusComponent="form">
    <data>
        <instance id="repairEstimateCatalogLinkDc" class="dev.buhanzaz.wmspanel.entity.RepairEstimateCatalogLink">
            <fetchPlan extends="_base">
                <property name="sourceNode" fetchPlan="_base"/>
                <property name="targetNode" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
        <collection id="catalogNodesDc" class="dev.buhanzaz.wmspanel.entity.RepairEstimateCatalogNode">
            <fetchPlan extends="_base"/>
            <loader id="catalogNodesDl" readOnly="true">
                <query><![CDATA[
                    select e from RepairEstimateCatalogNode e
                    order by coalesce(e.sortOrder, 2147483647), e.name
                ]]></query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <formLayout id="form" dataContainer="repairEstimateCatalogLinkDc">
            <entityComboBox id="sourceNodeField" property="sourceNode" itemsContainer="catalogNodesDc" required="true"/>
            <entityComboBox id="targetNodeField" property="targetNode" itemsContainer="catalogNodesDc" required="true"/>
            <comboBox id="linkTypeField" property="linkType" required="true"/>
            <checkbox id="activeField" property="active"/>
            <integerField id="sortOrderField" property="sortOrder"/>
            <textArea id="commentField" property="comment"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
