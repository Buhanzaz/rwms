<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://RentalAttributeDefinitionListView.title"
      focusComponent="rentalAttributeDefinitionsDataGrid">
    <data>
        <collection id="rentalAttributeDefinitionsDc"
                    class="dev.buhanzaz.wmspanel.entity.RentalAttributeDefinition">
            <fetchPlan extends="_base"/>
            <loader id="rentalAttributeDefinitionsDl" readOnly="true">
                <query>
                    <![CDATA[select e from RentalAttributeDefinition e order by e.sortOrder, e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="rentalAttributeDefinitionsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="rentalAttributeDefinitionsDataGrid.createAction"/>
                <button id="editButton" action="rentalAttributeDefinitionsDataGrid.editAction"/>
                <button id="removeButton" action="rentalAttributeDefinitionsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="rentalAttributeDefinitionsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="rentalAttributeDefinitionsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="rentalAttributeDefinitionsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="name"/>
                <column property="code"/>
                <column property="dataType"/>
                <column property="active"/>
                <column property="sortOrder"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
