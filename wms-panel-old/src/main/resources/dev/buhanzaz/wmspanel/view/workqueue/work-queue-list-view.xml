<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://WorkQueueListView.title"
      focusComponent="workQueuesDataGrid">
    <data>
        <collection id="workQueuesDc" class="dev.buhanzaz.wmspanel.entity.WorkQueue">
            <fetchPlan extends="_base">
                <property name="warehouse" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="workQueuesDl" readOnly="true">
                <query><![CDATA[select e from WorkQueue e order by e.warehouse.name, e.sortOrder, e.name]]></query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" text="Создать"/>
                <button id="editButton" text="Настроить"/>
                <button id="removeButton" action="workQueuesDataGrid.removeAction"/>
            </startSlot>
        </hbox>
        <dataGrid id="workQueuesDataGrid" width="100%" minHeight="20em" dataContainer="workQueuesDc">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="warehouse"/>
                <column property="code"/>
                <column property="name"/>
                <column property="queueKind"/>
                <column property="description"/>
                <column property="sortOrder"/>
                <column property="active"/>
                <column property="collapsed"/>
                <column property="hidden"/>
                <column property="sinkQueue"/>
                <column property="holdingPeriodMinutes"/>
                <column property="notificationThreshold"/>
                <column property="notifyWhenThresholdReached"/>
            </columns>
        </dataGrid>
    </layout>
</view>
