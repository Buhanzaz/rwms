<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://RentalClassifierAttributeListView.title"
      focusComponent="rentalClassifierAttributesDataGrid">
    <data>
        <collection id="rentalClassifierAttributesDc"
                    class="dev.buhanzaz.wmspanel.entity.RentalClassifierAttribute">
            <fetchPlan extends="_base">
                <property name="attributeDefinition" fetchPlan="_base"/>
                <property name="category" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="rentalClassifierAttributesDl" readOnly="true">
                <query>
                    <![CDATA[select e from RentalClassifierAttribute e order by e.sortOrder, e.attributeDefinition.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="rentalClassifierAttributesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="rentalClassifierAttributesDataGrid.createAction"/>
                <button id="editButton" action="rentalClassifierAttributesDataGrid.editAction"/>
                <button id="removeButton" action="rentalClassifierAttributesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="rentalClassifierAttributesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="rentalClassifierAttributesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="rentalClassifierAttributesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="attributeDefinition"/>
                <column property="category"/>
                <column property="active"/>
                <column property="sortOrder"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
