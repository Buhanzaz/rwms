<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://UserGridColumnSettingsDetailView.title"
      focusComponent="form">
    <data>
        <instance id="userGridColumnSettingsDc"
                  class="dev.buhanzaz.wmspanel.entity.UserGridColumnSettings">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
        <collection id="usersDc"
                    class="dev.buhanzaz.wmspanel.entity.User">
            <fetchPlan extends="_base"/>
            <loader id="usersDl" readOnly="true">
                <query>
                    <![CDATA[select e from wmspanel_User e where e.active = true order by e.username]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <formLayout id="form" dataContainer="userGridColumnSettingsDc">
            <entityComboBox id="userField" property="user" itemsContainer="usersDc" required="true"/>
            <textField id="gridCodeField" property="gridCode" required="true"/>
            <textField id="columnKeyField" property="columnKey" required="true"/>
            <checkbox id="visibleField" property="visible"/>
            <integerField id="sortOrderField" property="sortOrder"/>
            <textField id="widthField" property="width"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
