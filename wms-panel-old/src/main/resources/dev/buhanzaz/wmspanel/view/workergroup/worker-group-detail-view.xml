<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://WorkerGroupDetailView.title" focusComponent="form">
    <data>
        <instance id="workerGroupDc" class="dev.buhanzaz.wmspanel.entity.WorkerGroup">
            <fetchPlan extends="_base">
                <property name="warehouse" fetchPlan="_base"/>
                <property name="workerClass" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
    </data>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets><dataLoadCoordinator auto="true"/></facets>
    <layout>
        <formLayout id="form" dataContainer="workerGroupDc">
            <entityComboBox id="warehouseField" property="warehouse" required="true"/>
            <entityComboBox id="workerClassField" property="workerClass" required="true"/>
            <textField id="nameField" property="name" required="true"/>
            <textArea id="descriptionField" property="description"/>
            <checkbox id="activeField" property="active"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
