<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dev.buhanzaz.wmspanel.view.reservation/ReservationDetailView.title"
      focusComponent="reservationNumberField">
    <data>
        <instance id="reservationDc"
                  class="dev.buhanzaz.wmspanel.entity.Reservation">
            <fetchPlan extends="_base">
                <property name="warehouse" fetchPlan="_base"/>
                <property name="responsibleRentalManager" fetchPlan="_base"/>
                <property name="rentalItem" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
        <collection id="reservationItemsDc"
                    class="dev.buhanzaz.wmspanel.entity.ReservationLine">
            <fetchPlan extends="_base">
                <property name="reservation" fetchPlan="_base"/>
                <property name="rentalItem" fetchPlan="_base"/>
                <property name="stockItem" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="reservationItemsDl" readOnly="true">
                <query>
                    <![CDATA[
                        select e
                        from ReservationLine e
                        where e.reservation.id = :reservationId
                        order by e.createdDate
                    ]]>
                </query>
            </loader>
        </collection>
        <collection id="reservationAccessoriesDc"
                    class="dev.buhanzaz.wmspanel.entity.ReservationAccessory">
            <fetchPlan extends="_base">
                <property name="reservationItem" fetchPlan="_base">
                    <property name="rentalItem" fetchPlan="_base"/>
                </property>
                <property name="accessoryItem" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="reservationAccessoriesDl" readOnly="true">
                <query>
                    <![CDATA[
                        select e
                        from ReservationAccessory e
                        where :reservationItem is not null
                          and e.reservationItem = :reservationItem
                        order by e.createdDate
                    ]]>
                </query>
            </loader>
        </collection>
    </data>
    <layout>
        <vbox width="100%" spacing="true" padding="false">
            <formLayout id="headerForm" width="100%">
                <textField id="reservationNumberField" label="Номер" width="100%"/>
                <textField id="statusField" label="Статус" width="100%"/>
                <textField id="warehouseField" label="Склад" width="100%"/>
                <textField id="responsibleManagerField" label="Менеджер" width="100%"/>
                <textField id="clientTypeField" label="Тип клиента" width="100%"/>
                <textField id="individualLastNameField" label="Фамилия" width="100%"/>
                <textField id="individualFirstNameField" label="Имя" width="100%"/>
                <textField id="individualMiddleNameField" label="Отчество" width="100%"/>
                <textField id="companyNameField" label="Компания" width="100%"/>
                <dateTimePicker id="temporaryExpiresAtField" label="Срок временного" width="100%"/>
                <dateTimePicker id="paymentDueAtField" label="Срок оплаты" width="100%"/>
                <dateTimePicker id="confirmedAtField" label="Подтверждено" width="100%"/>
                <dateTimePicker id="cancelledAtField" label="Отменено" width="100%"/>
                <textArea id="cancelReasonField" label="Причина" width="100%"/>
                <textArea id="commentField" label="Комментарий" width="100%"/>
                <textField id="createdByField" label="Создал" width="100%"/>
                <dateTimePicker id="createdDateField" label="Создан" width="100%"/>
                <dateTimePicker id="updatedDateField" label="Изменён" width="100%"/>
            </formLayout>

            <hbox id="detailActions" classNames="buttons-panel">
                <button id="moveToWaitingPaymentButton"/>
                <button id="confirmPaymentButton"/>
                <button id="releaseItemButton"/>
                <button id="addAccessoryButton"/>
                <button id="cancelButton"/>
                <button id="deleteExpiredButton"/>
            </hbox>

            <dataGrid id="reservationItemsDataGrid"
                      width="100%"
                      height="18em"
                      dataContainer="reservationItemsDc"
                      selectionMode="SINGLE">
                <columns>
                    <column property="rentalItem"/>
                    <column property="stockItem"/>
                    <column property="quantity"/>
                    <column key="status" header="Статус резерва"/>
                    <column property="comment"/>
                </columns>
            </dataGrid>

            <dataGrid id="reservationAccessoriesDataGrid"
                      width="100%"
                      height="12em"
                      dataContainer="reservationAccessoriesDc">
                <columns>
                    <column property="accessoryItem"/>
                    <column property="quantity"/>
                    <column key="status" header="Статус"/>
                    <column property="comment"/>
                </columns>
            </dataGrid>

            <hbox id="footerActions" classNames="buttons-panel">
                <button id="closeButton"/>
            </hbox>
        </vbox>
    </layout>
</view>
