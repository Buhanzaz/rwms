<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dev.buhanzaz.wmspanel.view.reservation/ReservationListView.title"
      focusComponent="reservationsDataGrid">
    <data>
        <collection id="reservationsDc" class="dev.buhanzaz.wmspanel.entity.Reservation">
            <fetchPlan extends="_base">
                <property name="warehouse" fetchPlan="_base"/>
                <property name="responsibleRentalManager" fetchPlan="_base"/>
                <property name="rentalItem" fetchPlan="_base"/>
                <property name="reservationItems" fetchPlan="_base">
                    <property name="rentalItem" fetchPlan="_base"/>
                    <property name="stockItem" fetchPlan="_base"/>
                </property>
            </fetchPlan>
            <loader id="reservationsDl" readOnly="true">
                <query><![CDATA[select e from Reservation e]]></query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <vbox id="listPane" spacing="true" padding="false" width="100%">
            <hbox id="buttonsPanel" classNames="buttons-panel">
                <startSlot>
                    <button id="searchButton" text="Поиск и резерв"/>
                    <button id="openButton" text="Открыть"/>
                    <button id="deleteExpiredButton" text="Удалить резерв"/>
                    <button id="refreshButton" text="Обновить"/>
                </startSlot>
            </hbox>
            <dataGrid id="reservationsDataGrid"
                      width="100%"
                      height="100%"
                      minHeight="24em"
                      dataContainer="reservationsDc"
                      pageSize="50"
                      columnReorderingAllowed="true"
                      themeNames="column-borders row-stripes compact">
                <columns resizable="true">
                    <column key="items" header="Бытовки / объекты"/>
                    <column key="status" header="Статус"/>
                    <column property="warehouse"/>
                    <column property="responsibleRentalManager"/>
                    <column property="createdBy"/>
                    <column property="createdDate" header="Создан"/>
                    <column property="temporaryExpiresAt"/>
                    <column property="paymentDueAt"/>
                    <column property="cancelReason"/>
                    <column property="comment"/>
                </columns>
            </dataGrid>
        </vbox>
    </layout>
</view>
