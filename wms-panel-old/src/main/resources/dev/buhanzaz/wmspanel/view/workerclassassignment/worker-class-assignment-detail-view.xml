<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://WorkerClassAssignmentDetailView.title" focusComponent="form">
    <data>
        <instance id="workerClassAssignmentDc" class="dev.buhanzaz.wmspanel.entity.WorkerClassAssignment">
            <fetchPlan extends="_base">
                <property name="worker" fetchPlan="_base">
                    <property name="warehouse" fetchPlan="_base"/>
                </property>
                <property name="workerClass" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
        <collection id="workersDc" class="dev.buhanzaz.wmspanel.entity.Worker">
            <fetchPlan extends="_base">
                <property name="warehouse" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="workersDl" readOnly="true">
                <query><![CDATA[
                    select e from Worker e
                    where e.warehouse.id in :warehouseIds
                    order by e.warehouse.sortOrder, e.warehouse.name, e.displayName
                ]]></query>
            </loader>
        </collection>
        <collection id="workerClassesDc" class="dev.buhanzaz.wmspanel.entity.WorkerClass">
            <fetchPlan extends="_base"/>
            <loader id="workerClassesDl" readOnly="true">
                <query><![CDATA[select e from WorkerClass e where e.active = true order by e.sortOrder, e.name]]></query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets><dataLoadCoordinator auto="true"/></facets>
    <layout>
        <formLayout id="form" dataContainer="workerClassAssignmentDc">
            <entityComboBox id="workerField" property="worker" itemsContainer="workersDc" required="true"/>
            <entityComboBox id="workerClassField" property="workerClass" itemsContainer="workerClassesDc" required="true"/>
            <checkbox id="activeField" property="active"/>
            <textArea id="commentField" property="comment"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
