CREATE MEMORY TABLE PUBLIC.REPAIR_PROCESS(ID UUID NOT NULL,VERSION INTEGER NOT NULL,DELETED_BY VARCHAR(255),DELETED_DATE TIMESTAMP WITH TIME ZONE,LAST_MODIFIED_BY VARCHAR(255),LAST_MODIFIED_DATE TIMESTAMP WITH TIME ZONE,CREATED_BY VARCHAR(255),CREATED_DATE TIMESTAMP WITH TIME ZONE,ESTIMATE_ID UUID,RENTAL_ITEM_ID UUID NOT NULL,WAREHOUSE_ID UUID NOT NULL,STATUS VARCHAR(32) DEFAULT 'ACTIVE' NOT NULL,MOVE_TO_REPAIR_REQUIRED BOOLEAN DEFAULT FALSE,MOVE_TO_REPAIR_DONE BOOLEAN DEFAULT FALSE,MOVE_TO_REPAIR_CANCELLED BOOLEAN DEFAULT FALSE,MOVE_FROM_REPAIR_REQUIRED BOOLEAN DEFAULT FALSE,MOVE_FROM_REPAIR_DONE BOOLEAN DEFAULT FALSE,MOVE_FROM_REPAIR_CANCELLED BOOLEAN DEFAULT FALSE,ACCEPTED_AT TIMESTAMP WITH TIME ZONE,ACCEPTED_BY VARCHAR(255),ACCEPTANCE_COMMENT VARCHAR(2000),COMMENT_ VARCHAR(2000),PROCESS_KIND VARCHAR(32) DEFAULT 'ESTIMATE_REPAIR' NOT NULL,SOURCE_PROCESS_ID UUID,REQUESTED_WORKER_GROUP_ID UUID,REQUESTED_WORKER_ID UUID,CONSTRAINT PK_REPAIR_PROCESS PRIMARY KEY(ID),CONSTRAINT IDX_REPAIR_PROCESS_UNQ_ESTIMATE UNIQUE(ESTIMATE_ID),CONSTRAINT FK_REPAIR_PROCESS_ON_WAREHOUSE FOREIGN KEY(WAREHOUSE_ID) REFERENCES PUBLIC.WAREHOUSE(ID),CONSTRAINT FK_REPAIR_PROCESS_ON_ESTIMATE FOREIGN KEY(ESTIMATE_ID) REFERENCES PUBLIC.REPAIR_ESTIMATE(ID) ON DELETE CASCADE,CONSTRAINT FK_REPAIR_PROCESS_ON_RENTAL_ITEM FOREIGN KEY(RENTAL_ITEM_ID) REFERENCES PUBLIC.RENTAL_ITEM(ID) ON DELETE CASCADE,CONSTRAINT FK_REPAIR_PROCESS_ON_SOURCE_PROCESS FOREIGN KEY(SOURCE_PROCESS_ID) REFERENCES PUBLIC.REPAIR_PROCESS(ID),CONSTRAINT FK_REPAIR_PROCESS_ON_REQUESTED_WORKER_GROUP FOREIGN KEY(REQUESTED_WORKER_GROUP_ID) REFERENCES PUBLIC.WORKER_GROUP(ID),CONSTRAINT FK_REPAIR_PROCESS_ON_REQUESTED_WORKER FOREIGN KEY(REQUESTED_WORKER_ID) REFERENCES PUBLIC.WORKER(ID))
CREATE INDEX IDX_REPAIR_PROCESS_ON_SOURCE_PROCESS ON PUBLIC.REPAIR_PROCESS(SOURCE_PROCESS_ID)
CREATE INDEX IDX_REPAIR_PROCESS_ON_PROCESS_KIND ON PUBLIC.REPAIR_PROCESS(PROCESS_KIND)
CREATE MEMORY TABLE PUBLIC.REPAIR_PROCESS_TASK_LINE(ID UUID NOT NULL,TASK_PLAN_ID UUID NOT NULL,ESTIMATE_LINE_ID UUID NOT NULL,LINE_TYPE VARCHAR(32) DEFAULT 'WORK' NOT NULL,SORT_ORDER INTEGER DEFAULT 0 NOT NULL,PRIMARY_WORK_LINE BOOLEAN DEFAULT FALSE NOT NULL,CONSTRAINT PK_REPAIR_PROCESS_TASK_LINE PRIMARY KEY(ID),CONSTRAINT FK_REPAIR_PROCESS_TASK_LINE_ON_PLAN FOREIGN KEY(TASK_PLAN_ID) REFERENCES PUBLIC.REPAIR_ESTIMATE_TASK_PLAN(ID) ON DELETE CASCADE,CONSTRAINT FK_REPAIR_PROCESS_TASK_LINE_ON_LINE FOREIGN KEY(ESTIMATE_LINE_ID) REFERENCES PUBLIC.REPAIR_ESTIMATE_LINE(ID) ON DELETE CASCADE)
CREATE INDEX IDX_REPAIR_PROCESS_TASK_LINE_ON_PLAN ON PUBLIC.REPAIR_PROCESS_TASK_LINE(TASK_PLAN_ID)
CREATE MEMORY TABLE PUBLIC.BOARD_TASK_PHOTO_LINK(ID UUID NOT NULL,BOARD_TASK_ID UUID NOT NULL,PHOTO_ID UUID NOT NULL,PHOTO_TYPE VARCHAR(32) DEFAULT 'WORK' NOT NULL,SORT_ORDER INTEGER DEFAULT 0 NOT NULL,CONSTRAINT PK_BOARD_TASK_PHOTO_LINK PRIMARY KEY(ID),CONSTRAINT FK_BOARD_TASK_PHOTO_LINK_ON_TASK FOREIGN KEY(BOARD_TASK_ID) REFERENCES PUBLIC.BOARD_TASK(ID) ON DELETE CASCADE,CONSTRAINT FK_BOARD_TASK_PHOTO_LINK_ON_PHOTO FOREIGN KEY(PHOTO_ID) REFERENCES PUBLIC.RENTAL_ITEM_EVENT_PHOTO(ID) ON DELETE CASCADE)
CREATE MEMORY TABLE PUBLIC.RESERVATION_SEARCH_SETTINGS(ID UUID NOT NULL,VERSION INTEGER NOT NULL,DELETED_BY VARCHAR(255),DELETED_DATE TIMESTAMP WITH TIME ZONE,LAST_MODIFIED_BY VARCHAR(255),LAST_MODIFIED_DATE TIMESTAMP WITH TIME ZONE,CREATED_BY VARCHAR(255),CREATED_DATE TIMESTAMP WITH TIME ZONE,CODE VARCHAR(32) NOT NULL,RESERVATION_SEARCH_REFRESH_SECONDS INTEGER DEFAULT 10,CONSTRAINT PK_RESERVATION_SEARCH_SETTINGS PRIMARY KEY(ID),CONSTRAINT IDX_RES_SEARCH_SETTINGS_UNQ_CODE UNIQUE(CODE))
CREATE MEMORY TABLE PUBLIC.RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK(ID UUID NOT NULL,VERSION INTEGER NOT NULL,DELETED_BY VARCHAR(255),DELETED_DATE TIMESTAMP WITH TIME ZONE,LAST_MODIFIED_BY VARCHAR(255),LAST_MODIFIED_DATE TIMESTAMP WITH TIME ZONE,CREATED_BY VARCHAR(255),CREATED_DATE TIMESTAMP WITH TIME ZONE,RENTAL_CLASSIFIER_ATTRIBUTE_ID UUID NOT NULL,CATEGORY_ID UUID NOT NULL,CONSTRAINT PK_RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK PRIMARY KEY(ID),CONSTRAINT IDX_RENTAL_CLASSIFIER_ATTR_CATEGORY_UNQ UNIQUE(RENTAL_CLASSIFIER_ATTRIBUTE_ID,CATEGORY_ID),CONSTRAINT FK_RENTAL_CLASSIFIER_ATTR_CATEGORY_ON_BINDING FOREIGN KEY(RENTAL_CLASSIFIER_ATTRIBUTE_ID) REFERENCES PUBLIC.RENTAL_CLASSIFIER_ATTRIBUTE(ID) ON DELETE CASCADE,CONSTRAINT FK_RENTAL_CLASSIFIER_ATTR_CATEGORY_ON_CATEGORY FOREIGN KEY(CATEGORY_ID) REFERENCES PUBLIC.RENTAL_CATEGORY(ID))
CREATE INDEX IDX_RENTAL_CLASSIFIER_ATTR_CATEGORY_ON_BINDING ON PUBLIC.RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK(RENTAL_CLASSIFIER_ATTRIBUTE_ID)
CREATE INDEX IDX_RENTAL_CLASSIFIER_ATTR_CATEGORY_ON_CATEGORY ON PUBLIC.RENTAL_CLASSIFIER_ATTRIBUTE_CATEGORY_LINK(CATEGORY_ID)
CREATE MEMORY TABLE PUBLIC.RENTAL_ITEM_ACCESSORY(ID UUID NOT NULL,VERSION INTEGER,CREATED_BY VARCHAR(255),CREATED_DATE TIMESTAMP,LAST_MODIFIED_BY VARCHAR(255),LAST_MODIFIED_DATE TIMESTAMP,DELETED_BY VARCHAR(255),DELETED_DATE TIMESTAMP,RENTAL_ITEM_ID UUID NOT NULL,ACCESSORY_ITEM_ID UUID NOT NULL,QUANTITY INTEGER DEFAULT 0 NOT NULL,CONSTRAINT PK_RENTAL_ITEM_ACCESSORY PRIMARY KEY(ID),CONSTRAINT FK_RENTAL_ITEM_ACCESSORY_ON_ACCESSORY_ITEM FOREIGN KEY(ACCESSORY_ITEM_ID) REFERENCES PUBLIC.ACCESSORY_ITEM(ID),CONSTRAINT IDX_RENTAL_ITEM_ACCESSORY_UNQ_ITEM_ACCESSORY UNIQUE(RENTAL_ITEM_ID,ACCESSORY_ITEM_ID),CONSTRAINT FK_RENTAL_ITEM_ACCESSORY_ON_RENTAL_ITEM FOREIGN KEY(RENTAL_ITEM_ID) REFERENCES PUBLIC.RENTAL_ITEM(ID) ON DELETE CASCADE)
CREATE INDEX IDX_RENTAL_ITEM_ACCESSORY_RENTAL_ITEM ON PUBLIC.RENTAL_ITEM_ACCESSORY(RENTAL_ITEM_ID)
CREATE INDEX IDX_RENTAL_ITEM_ACCESSORY_ACCESSORY_ITEM ON PUBLIC.RENTAL_ITEM_ACCESSORY(ACCESSORY_ITEM_ID)
CREATE MEMORY TABLE PUBLIC.RENTAL_ITEM_EVENT_ACCESSORY(ID UUID NOT NULL,VERSION INTEGER,CREATED_BY VARCHAR(255),CREATED_DATE TIMESTAMP,LAST_MODIFIED_BY VARCHAR(255),LAST_MODIFIED_DATE TIMESTAMP,DELETED_BY VARCHAR(255),DELETED_DATE TIMESTAMP,EVENT_ID UUID NOT NULL,ACCESSORY_ITEM_ID UUID NOT NULL,QUANTITY INTEGER DEFAULT 0 NOT NULL,CONSTRAINT PK_RENTAL_ITEM_EVENT_ACCESSORY PRIMARY KEY(ID),CONSTRAINT FK_RENTAL_ITEM_EVENT_ACCESSORY_ON_ACCESSORY_ITEM FOREIGN KEY(ACCESSORY_ITEM_ID) REFERENCES PUBLIC.ACCESSORY_ITEM(ID),CONSTRAINT IDX_RENTAL_ITEM_EVENT_ACC_UNQ_EVENT_ACCESSORY UNIQUE(EVENT_ID,ACCESSORY_ITEM_ID),CONSTRAINT FK_RENTAL_ITEM_EVENT_ACCESSORY_ON_EVENT FOREIGN KEY(EVENT_ID) REFERENCES PUBLIC.RENTAL_ITEM_EVENT(ID) ON DELETE CASCADE)
CREATE INDEX IDX_RENTAL_ITEM_EVENT_ACCESSORY_EVENT ON PUBLIC.RENTAL_ITEM_EVENT_ACCESSORY(EVENT_ID)
ALTER TABLE PUBLIC.RENTAL_ITEM ADD CONSTRAINT FK_RENTAL_ITEM_ON_WAREHOUSE FOREIGN KEY(WAREHOUSE_ID) REFERENCES PUBLIC.WAREHOUSE(ID)
ALTER TABLE PUBLIC.RENTAL_ITEM ADD CONSTRAINT FK_RENTAL_ITEM_ON_CONDITION FOREIGN KEY(CONDITION_ID) REFERENCES PUBLIC.RENTAL_ITEM_CONDITION(ID)
ALTER TABLE PUBLIC.WORKER_GROUP_MEMBER ADD CONSTRAINT FK_WORKER_GROUP_MEMBER_ON_WORKER FOREIGN KEY(WORKER_ID) REFERENCES PUBLIC.WORKER(ID)
ALTER TABLE PUBLIC.BOARD_TASK ADD CONSTRAINT FK_BOARD_TASK_ON_REPAIR_PROCESS FOREIGN KEY(REPAIR_PROCESS_ID) REFERENCES PUBLIC.REPAIR_PROCESS(ID) ON DELETE CASCADE
ALTER TABLE PUBLIC.TASK_ASSIGNMENT ADD CONSTRAINT FK_TASK_ASSIGNMENT_ON_WORKER FOREIGN KEY(WORKER_ID) REFERENCES PUBLIC.WORKER(ID)
ALTER TABLE PUBLIC.TASK_TIME_EVENT ADD CONSTRAINT FK_TASK_TIME_EVENT_ON_WORKER FOREIGN KEY(WORKER_ID) REFERENCES PUBLIC.WORKER(ID)
ALTER TABLE PUBLIC.REPAIR_ESTIMATE ADD CONSTRAINT FK_REPAIR_ESTIMATE_ON_LATEST_EVENT FOREIGN KEY(LATEST_EVENT_ID) REFERENCES PUBLIC.RENTAL_ITEM_EVENT(ID) ON DELETE CASCADE
ALTER TABLE PUBLIC.RENTAL_ITEM_EVENT ADD CONSTRAINT FK_RENTAL_ITEM_EVENT_ON_WORKER FOREIGN KEY(WORKER_ID) REFERENCES PUBLIC.WORKER(ID)
ALTER TABLE PUBLIC.RENTAL_ITEM_EVENT ADD CONSTRAINT FK_RENTAL_ITEM_EVENT_ON_REPAIR_PROCESS FOREIGN KEY(REPAIR_PROCESS_ID) REFERENCES PUBLIC.REPAIR_PROCESS(ID) ON DELETE CASCADE
ALTER TABLE PUBLIC.ACCESSORY_ITEM ADD CONSTRAINT FK_ACCESSORY_ITEM_ON_FURNITURE_MATERIAL FOREIGN KEY(FURNITURE_MATERIAL_ID) REFERENCES PUBLIC.REPAIR_ESTIMATE_CATALOG_NODE(ID)
ALTER TABLE PUBLIC.REPAIR_ESTIMATE_TASK_PLAN ADD CONSTRAINT FK_REPAIR_ESTIMATE_TASK_PLAN_ON_PROCESS FOREIGN KEY(REPAIR_PROCESS_ID) REFERENCES PUBLIC.REPAIR_PROCESS(ID) ON DELETE CASCADE
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
SET DATABASE DEFAULT INITIAL SCHEMA PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CARDINAL_NUMBER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.YES_OR_NO TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CHARACTER_DATA TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.SQL_IDENTIFIER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.TIME_STAMP TO PUBLIC
GRANT DBA TO SA
SET SCHEMA SYSTEM_LOBS
INSERT INTO BLOCKS VALUES(0,2147483647,0)
SET SCHEMA PUBLIC
