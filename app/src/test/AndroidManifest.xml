<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
          Manager login follows the HTTPS gateway callback inside NativeManagerLoginClient.
          AppAuth is retained for request/token models, but its custom-scheme receiver is not a
          supported entry point in the Robolectric test APK either.
        -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            tools:node="remove" />
    </application>

</manifest>
