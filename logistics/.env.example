# Runtime ports on the host.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Local simulator database. Change these values outside source control when needed.
POSTGRES_DB=logistics
POSTGRES_USER=logistics
POSTGRES_PASSWORD=logistics
DATABASE_URL=postgresql+psycopg://logistics:logistics@db:5432/logistics

# Safe truck routes over the private OpenStreetMap-backed Valhalla container.
# `mock` remains available for deterministic tests; `osrm` remains an explicit
# legacy development option and is never used as a truck-route fallback.
ROUTING_PROVIDER=valhalla
VALHALLA_ENABLED=true
VALHALLA_URL=http://valhalla:8002
VALHALLA_HOST_PORT=8002
VALHALLA_TIMEOUT_SECONDS=30
VALHALLA_SERVER_THREADS=2
# Update this immutable identity whenever the PBF/tiles volume is rebuilt.
OSM_DATA_VERSION=central-northwestern-fed-districts-2026-08-26
# Atomic PostGIS restriction import batch size (1..10000). Both source PBFs are
# mounted read-only from the shared logistics-osrm-data volume.
OSM_RESTRICTIONS_BATCH_SIZE=1000

# OSRM is kept behind the explicit Compose profile `legacy-routing` for
# backwards-compatible development runs. It is never a truck-route fallback.
OSRM_BASE_URL=http://osrm:5000
OSRM_PROFILE=driving
OSRM_TIMEOUT_SECONDS=15
# Both downloaded PBFs are mounted read-only into Valhalla. Replacing either URL
# changes the source manifest and rebuilds the derived Valhalla graph.
OSRM_DATA_URL=https://download.geofabrik.de/russia/central-fed-district-latest.osm.pbf
OSM_NORTHWESTERN_DATA_URL=https://download.geofabrik.de/russia/northwestern-fed-district-latest.osm.pbf
DEFAULT_WAREHOUSE_TIMEZONE=Europe/Moscow
PLANNER_DEFAULT_SEED=20260822

# Free OpenFreeMap style backed by OpenStreetMap. Leave empty for the built-in
# neutral grid mode when the browser has no external network access.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_API_BASE_URL=/api
# Vite public base. For the current VPS reverse proxy use
# /logistics-simulator/ together with
# VITE_API_BASE_URL=/logistics-simulator/api.
VITE_APP_BASE_PATH=/

# Operator address autocomplete and reverse geocoding. Yandex issues separate
# keys for Geosuggest and Geocoder; keep both only in the backend runtime env.
YANDEX_GEOSUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOCODING_TIMEOUT_SECONDS=5

# Optional RWMS integration. Enable only after auth-service provisions the
# dedicated client_credentials client with its exact logistics.planning scope.
RWMS_SYNC_ENABLED=false
RWMS_CAPACITY_PUBLISH_ENABLED=false
RWMS_LOGISTICS_BASE_URL=http://host.docker.internal:8080
RWMS_TOKEN_URL=http://host.docker.internal:8080/oauth2/token
RWMS_CLIENT_ID=logistics-planner
RWMS_CLIENT_SECRET=replace-with-a-long-random-runtime-secret
RWMS_TIMEOUT_SECONDS=15
