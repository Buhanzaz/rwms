# Runtime ports on the host.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Local simulator database. Change these values outside source control when needed.
POSTGRES_DB=logistics
POSTGRES_USER=logistics
POSTGRES_PASSWORD=logistics
DATABASE_URL=postgresql+psycopg://logistics:logistics@db:5432/logistics

# Real driving routes over the private OpenStreetMap-backed OSRM container.
# Use mock only for a completely network-free deterministic test run.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=http://osrm:5000
OSRM_PROFILE=driving
OSRM_TIMEOUT_SECONDS=15
# Use a smaller regional extract in production. Replacing this URL requires a
# fresh logistics-osrm-data Docker volume so the routing graph is rebuilt.
OSRM_DATA_URL=https://download.geofabrik.de/russia/central-fed-district-latest.osm.pbf
DEFAULT_SCENARIO_TIMEZONE=Europe/Moscow
PLANNER_DEFAULT_SEED=20260822

# Free OpenFreeMap style backed by OpenStreetMap. Leave empty for the built-in
# neutral grid mode when the browser has no external network access.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_API_BASE_URL=/api
# Vite public base. For the current VPS reverse proxy use /logistics/ together
# with VITE_API_BASE_URL=/logistics/api.
VITE_APP_BASE_PATH=/

# Optional RWMS integration. Enable only after auth-service provisions the
# dedicated client_credentials client with its exact logistics.planning scope.
RWMS_SYNC_ENABLED=false
RWMS_LOGISTICS_BASE_URL=http://host.docker.internal:8080
RWMS_TOKEN_URL=http://host.docker.internal:8080/oauth2/token
RWMS_CLIENT_ID=logistics-planner
RWMS_CLIENT_SECRET=replace-with-a-long-random-runtime-secret
RWMS_TIMEOUT_SECONDS=15
